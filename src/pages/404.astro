---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Karlo Jagar" description="The requested portfolio page could not be found.">
  <main class="not-found">
    <p class="section-label">Error / 404</p>
    <h1>Page not found</h1>
    <p>This page is not part of the current build.</p>
    <a class="button primary" href={import.meta.env.BASE_URL}>Return home <span aria-hidden="true">←</span></a>
  </main>
</BaseLayout>