---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Karlo Jagar" description="The requested portfolio page could not be found.">
  <main class="min-h-screen bg-paper px-6 py-20 sm:px-10 lg:px-[8vw] lg:py-28">
    <p class="font-mono text-[10px] uppercase text-ink/50">Error / 404</p>
    <h1 class="my-16 text-6xl leading-[.92] font-semibold tracking-[-0.04em] sm:text-7xl lg:text-8xl">Page not found</h1>
    <p class="mb-8 text-lg text-ink/70">This page is not part of the current build.</p>
    <a class="inline-flex items-center gap-8 bg-ink px-5 py-4 font-mono text-[10px] uppercase text-paper no-underline transition-colors hover:bg-steel" href={import.meta.env.BASE_URL}>Return home <span aria-hidden="true">←</span></a>
  </main>
</BaseLayout>