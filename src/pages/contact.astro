---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalField from "../components/SignalField.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout
  title="Contact | Karlo Jagar"
  description="Connect with Karlo Jagar about platform engineering, cloud infrastructure, observability, and developer tooling."
>
  <SiteHeader />
  <SignalField scene="bridge" />
  <main id="main-content" class="relative z-10 min-h-[calc(100svh-3.5rem)]">
    <section class="relative overflow-hidden px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="relative z-10 mx-auto max-w-[94rem]">
        <p class="inline-flex items-center gap-2.5 font-mono text-xs uppercase text-accent"><span class="size-1.5 rounded-full bg-accent"></span> Contact / Open channels</p>
        <h1 class="cosmos-text-gradient my-10 max-w-6xl text-6xl leading-[1.12] font-semibold sm:text-7xl lg:text-8xl">Get in touch</h1>
        <p class="max-w-3xl text-lg leading-8 text-muted">I am interested in platform engineering, cloud infrastructure, observability, and developer tooling. The best places to reach me are LinkedIn and GitHub.</p>
        <div class="mt-16 grid max-w-5xl border-t border-border bg-surface/65 backdrop-blur-md sm:grid-cols-2">
          <a class="cosmos-card group grid grid-cols-[2rem_1fr] gap-3 border-b border-border px-5 py-7 no-underline sm:border-r" href="https://www.linkedin.com/in/karlojagar/" target="_blank" rel="noreferrer"><span class="font-mono text-xs uppercase text-accent">01</span><strong class="text-2xl font-medium transition-colors group-hover:text-accent">LinkedIn</strong><small class="col-start-2 font-mono text-xs uppercase text-muted">Professional contact ↗</small></a>
          <a class="cosmos-card group grid grid-cols-[2rem_1fr] gap-3 border-b border-border px-5 py-7 no-underline" href="https://github.com/jagarkarlo" target="_blank" rel="noreferrer"><span class="font-mono text-xs uppercase text-accent">02</span><strong class="text-2xl font-medium transition-colors group-hover:text-accent">GitHub</strong><small class="col-start-2 font-mono text-xs uppercase text-muted">Public work ↗</small></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
