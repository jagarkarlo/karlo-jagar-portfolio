---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout
  title="Contact | Karlo Jagar"
  description="Connect with Karlo Jagar about platform engineering, cloud infrastructure, observability, and developer tooling."
>
  <SiteHeader />
  <main id="main-content" class="min-h-[calc(100svh-3.5rem)] bg-canvas">
    <section class="px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="mx-auto max-w-[94rem]">
        <p class="font-mono text-xs uppercase text-accent">Contact / Open channels</p>
        <h1 class="my-10 max-w-6xl text-6xl leading-[.92] font-semibold sm:text-7xl lg:text-8xl">Get in touch</h1>
        <p class="max-w-3xl text-lg leading-8 text-muted">I am interested in platform engineering, cloud infrastructure, observability, and developer tooling. The best places to reach me are LinkedIn and GitHub.</p>
        <div class="mt-16 grid max-w-5xl border-t border-border sm:grid-cols-2">
          <a class="group grid grid-cols-[2rem_1fr] gap-3 border-b border-border py-7 no-underline sm:border-r sm:pr-6" href="https://www.linkedin.com/in/karlojagar/" target="_blank" rel="noreferrer"><span class="font-mono text-xs uppercase text-accent">01</span><strong class="text-2xl font-medium transition-colors group-hover:text-accent">LinkedIn</strong><small class="col-start-2 font-mono text-xs uppercase text-muted">Professional contact ↗</small></a>
          <a class="group grid grid-cols-[2rem_1fr] gap-3 border-b border-border py-7 no-underline sm:pl-6" href="https://github.com/jagarkarlo" target="_blank" rel="noreferrer"><span class="font-mono text-xs uppercase text-accent">02</span><strong class="text-2xl font-medium transition-colors group-hover:text-accent">GitHub</strong><small class="col-start-2 font-mono text-xs uppercase text-muted">Public work ↗</small></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
