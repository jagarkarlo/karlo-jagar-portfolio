---
import AcademicProjects from "../components/AcademicProjects.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import SignalField from "../components/SignalField.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { profile } from "../data/profile";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Work | Karlo Jagar"
  description="Public platform, cloud, developer tooling, network security, game systems, and academic projects by Karlo Jagar."
>
  <SiteHeader />
  <SignalField scene="cluster" />
  <main id="main-content" class="relative z-10">
    <header class="relative overflow-hidden px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="relative z-10 mx-auto max-w-[94rem]">
        <p class="inline-flex items-center gap-2.5 font-mono text-xs uppercase text-accent"><span class="size-1.5 rounded-full bg-accent"></span> Work / Public and academic</p>
        <h1 class="cosmos-text-gradient my-10 text-6xl leading-[1.12] font-semibold sm:text-7xl lg:text-8xl">Projects</h1>
        <p class="ml-auto max-w-3xl text-lg leading-8 text-muted sm:text-xl">Twelve public engineering repositories and six university projects spanning disaster-recovery verification (Nostekon), AI DevOps benchmarks (OpsBench), Model Context Protocol servers, Kubernetes/Ray diagnostics, semantic Grafana drift detection, SDN security, and game systems.</p>
      </div>
    </header>
    <section class="border-y border-border/80 bg-surface/82 px-5 py-20 sm:px-10 lg:px-[6vw] lg:py-24" aria-labelledby="public-work-title">
      <div class="mx-auto mb-12 grid max-w-[94rem] gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
        <div><p class="font-mono text-xs uppercase text-accent">Public repositories</p><h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="public-work-title">Engineering projects</h2></div>
        <p class="max-w-lg text-sm leading-6 text-muted lg:justify-self-end">Each project links to its public repository, source code, and documentation.</p>
      </div>
      <ProjectList projects={projects} />
    </section>
    <AcademicProjects projects={profile.academicProjects} />
  </main>
  <SiteFooter />
</BaseLayout>
