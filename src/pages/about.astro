---
import BaseLayout from "../layouts/BaseLayout.astro";
import Credentials from "../components/Credentials.astro";
import ProfileTimeline from "../components/ProfileTimeline.astro";
import Recognition from "../components/Recognition.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title="About | Karlo Jagar"
  description="Karlo Jagar's experience, education, professional perspective, recognition, and credentials."
>
  <SiteHeader />
  <main id="main-content">
    <header class="page-hero">
      <p class="section-label">About</p>
      <h1>About me</h1>
      <div class="page-intro">
        <p>{profile.summary}</p>
        <p>{profile.perspective}</p>
      </div>
      <dl class="profile-facts" aria-label="Profile summary">
        <div><dt>Based in</dt><dd>Zagreb area, Croatia</dd></div>
        <div><dt>Current role</dt><dd>DevOps Engineer</dd></div>
        <div><dt>Current study</dt><dd>Business Systems Organization, MSc</dd></div>
        <div><dt>International</dt><dd>Erasmus+ at FEUP, Porto</dd></div>
      </dl>
    </header>
    <ProfileTimeline id="experience" label="01" title="Experience" items={profile.experience} />
    <ProfileTimeline id="education" label="02" title="Education" items={profile.education} tone="mist" />
    <Recognition items={profile.recognition} />
    <Credentials certifications={profile.certifications} languages={profile.languages} />
  </main>
  <SiteFooter />
</BaseLayout>
