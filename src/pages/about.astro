---
import BaseLayout from "../layouts/BaseLayout.astro";
import Credentials from "../components/Credentials.astro";
import ProfileTimeline from "../components/ProfileTimeline.astro";
import Recognition from "../components/Recognition.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import { SITE, withBase } from "../config";
---

<BaseLayout
  title="About | Karlo Jagar"
  description="Karlo Jagar's experience, education, professional perspective, recognition, and credentials."
>
  <SiteHeader />
  <main id="main-content">
    <header class="bg-canvas px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28">
      <div class="mx-auto max-w-[94rem]">
        <p class="font-mono text-xs uppercase text-accent">About / Profile</p>
        <h1 class="my-10 text-6xl leading-[.92] font-semibold sm:text-7xl lg:text-8xl">About me</h1>
        <div class="ml-auto grid max-w-5xl gap-8 text-lg leading-8 text-muted sm:grid-cols-2">
          <p>{profile.summary}</p><p>{profile.perspective}</p>
        </div>
        <dl class="ml-auto mt-12 grid max-w-5xl sm:grid-cols-2" aria-label="Profile summary">
          <div class="border-t border-border py-4 sm:pr-6"><dt class="font-mono text-xs uppercase text-muted">Based in</dt><dd class="m-0 mt-2 text-sm">Zagreb area, Croatia</dd></div>
          <div class="border-t border-border py-4 sm:pl-6"><dt class="font-mono text-xs uppercase text-muted">Current role</dt><dd class="m-0 mt-2 text-sm">DevOps Engineer</dd></div>
          <div class="border-t border-border py-4 sm:pr-6"><dt class="font-mono text-xs uppercase text-muted">Current study</dt><dd class="m-0 mt-2 text-sm">Business Systems Organization, MSc</dd></div>
          <div class="border-t border-border py-4 sm:pl-6"><dt class="font-mono text-xs uppercase text-muted">International</dt><dd class="m-0 mt-2 text-sm">Erasmus+ at FEUP, Porto</dd></div>
        </dl>
        {SITE.cv && (
          <p class="ml-auto mt-10 max-w-5xl">
            <a class="inline-flex items-center gap-3 border border-border bg-surface px-5 py-3 font-mono text-xs uppercase text-foreground no-underline transition-colors hover:border-accent hover:text-accent" href={withBase(SITE.cv)} download>
              Download CV <span aria-hidden="true">↓</span>
            </a>
          </p>
        )}
      </div>
    </header>
    <ProfileTimeline id="experience" label="Career" title="Experience" items={profile.experience} />
    <ProfileTimeline id="education" label="Study" title="Education" items={profile.education} tone="mist" />
    <Recognition items={profile.recognition} />
    <Credentials certifications={profile.certifications} languages={profile.languages} />
  </main>
  <SiteFooter />
</BaseLayout>
