---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectList from "../components/ProjectList.astro";
import SignalField from "../components/SignalField.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TechnologyStack from "../components/TechnologyStack.astro";
import { getCollection } from "astro:content";
import { SITE, withBase } from "../config";

const featured = (await getCollection("projects", ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Karlo Jagar | DevOps & Platform Engineer"
  description="Karlo Jagar builds observable cloud platforms, reliable delivery workflows, and focused developer tools."
>
  <SiteHeader />
  <SignalField scene="galaxy" />
  <main id="main-content" class="relative z-10">
    <header class="relative overflow-hidden px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-28" aria-labelledby="hero-title">
      <div class="relative z-10 mx-auto max-w-[94rem]">
        <div class="flex flex-wrap items-center gap-4">
          <div class="size-12 shrink-0 overflow-hidden rounded-full border border-border bg-raised">
            <img
              src={withBase("/images/karlo-jagar-portrait.webp")}
              alt="Karlo Jagar"
              width="1200"
              height="1200"
              fetchpriority="high"
              class="size-full object-cover"
            />
          </div>
          <p class="m-0 inline-flex items-center gap-2.5 font-mono text-xs uppercase text-accent">
            <span class="size-1.5 rounded-full bg-accent"></span> DevOps &amp; Platform Engineer · Varaždin · Zagreb
          </p>
        </div>
        <h1 class="cosmos-text-gradient my-10 text-6xl leading-[1.12] font-semibold sm:text-7xl lg:text-8xl" id="hero-title">
          Karlo Jagar
        </h1>
        <p class="ml-auto max-w-3xl text-lg leading-8 text-muted sm:text-xl">
          I build observable cloud platforms, reliable delivery workflows, and focused developer tools that make complex infrastructure easier to operate and understand.
        </p>
        <div class="ml-auto mt-10 flex max-w-3xl flex-wrap items-center gap-3">
          <a
            class="inline-flex items-center gap-6 border border-accent bg-accent px-5 py-3 font-mono text-xs uppercase text-canvas no-underline transition-colors hover:bg-transparent hover:text-accent"
            href={withBase("/work/")}
          >
            Explore work <span aria-hidden="true">→</span>
          </a>
          <a
            class="border border-border bg-surface/75 px-5 py-3 font-mono text-xs uppercase text-foreground no-underline transition-colors hover:border-accent hover:text-accent"
            href={withBase("/about/")}
          >
            About me
          </a>
          {SITE.cv && (
            <a
              class="border border-border bg-surface/75 px-5 py-3 font-mono text-xs uppercase text-muted no-underline transition-colors hover:border-accent hover:text-accent"
              href={withBase(SITE.cv)}
              download
            >
              Download CV <span aria-hidden="true">↓</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <section
      class="border-y border-border/80 bg-surface/82 px-5 py-20 sm:px-10 lg:px-[6vw] lg:py-24"
      id="selected-work"
      aria-labelledby="selected-work-title"
      data-reveal
    >
      <div class="mx-auto mb-12 grid max-w-[94rem] gap-10 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
        <div>
          <p class="font-mono text-xs uppercase text-accent">Selected work</p>
          <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="selected-work-title">Featured projects</h2>
        </div>
        <p class="max-w-lg text-sm leading-6 text-muted lg:justify-self-end">
          Public repositories and engineering case studies. <a class="font-mono text-xs uppercase text-foreground underline decoration-border underline-offset-4 transition-colors hover:text-accent" href={withBase("/work/")}>View all work →</a>
        </p>
      </div>
      <ProjectList projects={featured} />
    </section>

    <div id="stack-section">
      <TechnologyStack />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
