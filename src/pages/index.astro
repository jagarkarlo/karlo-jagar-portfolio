---
import BaseLayout from "../layouts/BaseLayout.astro";
import EdgeStars from "../components/EdgeStars.astro";
import HomeFlow from "../components/HomeFlow.astro";
import ProjectList from "../components/ProjectList.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TechnologyStack from "../components/TechnologyStack.astro";
import { getCollection } from "astro:content";

const featured = (await getCollection("projects", ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Karlo Jagar | DevOps & Platform Engineer"
  description="Karlo Jagar builds observable cloud platforms, reliable delivery workflows, and focused developer tools."
>
  <SiteHeader />
  <main id="main-content" class="relative z-10">
    <section class="home-journey" data-home-journey aria-labelledby="hero-title">
      <div class="home-atmosphere"><EdgeStars /></div>
      <div class="home-intro">
        <div class="relative flex min-h-11 items-center pr-14">
          <p class="m-0 flex items-center gap-3 font-mono text-xs uppercase text-muted">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_10px_var(--theme-accent)]"></span>
            Varaždin · Zagreb
          </p>
        </div>

        <div class="home-intro__body">
          <div class="flex max-w-[38rem] flex-col items-start text-left">
            <div class="flex items-center gap-4">
              <div class="size-14 shrink-0 overflow-hidden rounded-full border border-border bg-raised">
                <img
                  src={`${base}/images/karlo-jagar-portrait.webp`}
                  alt="Karlo Jagar"
                  width="1200"
                  height="1200"
                  fetchpriority="high"
                  class="size-full object-cover"
                />
              </div>
              <div>
                <p class="m-0 font-mono text-xs uppercase tracking-widest text-accent">DevOps &amp; Platform Engineer</p>
                <p class="m-0 mt-1 font-mono text-xs text-muted">SICK Mobilisis · FOI MSc</p>
              </div>
            </div>

            <h1
              class="cosmos-text-gradient home-title mt-7 mb-0 text-6xl font-semibold tracking-tight sm:text-7xl"
              id="hero-title"
            >
              Karlo Jagar
            </h1>

            <p class="mt-6 mb-0 max-w-xl text-base leading-7 text-muted sm:text-lg sm:leading-8">
              I build reliable cloud platforms and tools that make complex systems easier to understand.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                class="inline-flex items-center gap-6 border border-accent bg-accent px-5 py-3 font-mono text-xs uppercase text-canvas no-underline transition-colors hover:bg-transparent hover:text-accent"
                href={`${base}/work/`}
              >
                Explore work <span aria-hidden="true">→</span>
              </a>
              <a
                class="border border-border bg-surface/75 px-5 py-3 font-mono text-xs uppercase text-foreground no-underline transition-colors hover:border-accent hover:text-accent"
                href={`${base}/about/`}
              >
                About me
              </a>
            </div>
          </div>
        </div>

        <div class="relative flex justify-start">
          <a
            href="#selected-work"
            aria-label="Scroll to featured projects"
            class="inline-flex min-h-11 items-center gap-3 font-mono text-xs uppercase text-muted no-underline transition-colors hover:text-accent"
          >
            <span>Explore the work</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>

      <div class="home-visual-rail"><HomeFlow /></div>

      <div class="home-bridge" id="selected-work">
        <p class="font-mono text-xs uppercase text-accent">Selected work</p>
        <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="selected-work-title">Featured projects</h2>
        <a
          class="mt-8 inline-flex font-mono text-xs uppercase text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent"
          href={`${base}/work/`}
        >
          View all work <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section
      class="border-t border-border/80 bg-surface/82 px-5 py-20 sm:px-10 lg:px-[6vw] lg:py-28"
      aria-labelledby="selected-work-title"
      data-reveal
    >
      <ProjectList projects={featured} />
    </section>
    <div id="stack-section">
      <TechnologyStack />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  #selected-work { scroll-margin-top: 4rem; }

  .home-journey { position: relative; }

  .home-atmosphere {
    inset: 2rem 1.5rem;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  .home-intro {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.5rem 0;
    position: relative;
    z-index: 1;
  }

  .home-intro__body { padding-block: 3.5rem; }
  .home-visual-rail { min-width: 0; position: relative; }
  .home-bridge { padding: 3rem 1.5rem 5rem; }

  @media (min-width: 40rem) {
    .home-atmosphere { inset-inline: 2.5rem; }
    .home-intro { padding-inline: 2.5rem; }
    .home-bridge { padding-inline: 2.5rem; }
  }

  @media (min-width: 64rem) {
    .home-journey {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: minmax(calc(100svh - 3.5rem), auto) minmax(62svh, auto);
    }

    .home-atmosphere { inset-inline: 5vw; }
    .home-intro {
      grid-column: 1;
      grid-row: 1;
      padding: 2rem 1rem 2rem 5vw;
    }
    .home-intro__body { align-content: center; display: grid; flex: 1; padding-block: 4rem; }
    .home-title { font-size: clamp(4rem, 5.8vw, 5.25rem); }
    .home-visual-rail { grid-column: 2; grid-row: 1 / 3; }
    .home-bridge { align-content: center; grid-column: 1; grid-row: 2; padding: 4rem 1rem 4rem 5vw; }
  }
</style>
