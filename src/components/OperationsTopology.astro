<canvas class="pointer-events-none absolute inset-0 size-full opacity-45" data-operations-topology aria-hidden="true"></canvas>

<script is:inline data-astro-rerun>
  window.__operationsTopologyController?.abort();
  const controller = new AbortController();
  window.__operationsTopologyController = controller;
  const canvas = document.querySelector("[data-operations-topology]");

  if (canvas instanceof HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    const section = canvas.parentElement;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nodes = [
      { x: 0.08, y: 0.08, label: "EDGE" },
      { x: 0.32, y: 0.14, label: "INGRESS" },
      { x: 0.66, y: 0.09, label: "API" },
      { x: 0.91, y: 0.18, label: "STORE" },
      { x: 0.16, y: 0.43, label: "GITOPS" },
      { x: 0.48, y: 0.36, label: "CLUSTER" },
      { x: 0.79, y: 0.47, label: "QUEUE" },
      { x: 0.28, y: 0.72, label: "METRICS" },
      { x: 0.61, y: 0.65, label: "TRACES" },
      { x: 0.88, y: 0.82, label: "ALERT" },
      { x: 0.09, y: 0.91, label: "RECOVERY" },
      { x: 0.53, y: 0.93, label: "HEALTHY" },
    ];
    const links = [[0, 1], [1, 2], [1, 4], [2, 3], [2, 5], [3, 6], [4, 5], [4, 7], [5, 6], [5, 8], [6, 8], [6, 9], [7, 8], [7, 10], [8, 9], [8, 11], [9, 11], [10, 11]];
    let width = 0;
    let height = 0;
    let frame = 0;
    let pointer = { x: -1000, y: -1000 };

    const resize = () => {
      if (!section || !context) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      width = section.clientWidth;
      height = section.clientHeight;
      pointer = { x: -1000, y: -1000 };
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const draw = (time = 0) => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      const cellHeight = Math.min(720, Math.max(520, window.innerHeight * 0.8));
      const pointGroups = [];
      for (let cellTop = 0; cellTop < height; cellTop += cellHeight) {
        pointGroups.push(nodes.map((node) => ({ ...node, px: node.x * width, py: cellTop + node.y * cellHeight })));
      }

      context.strokeStyle = "rgba(169, 199, 178, 0.16)";
      context.lineWidth = 1;
      pointGroups.forEach((points, groupIndex) => {
        links.forEach(([from, to], index) => {
          const start = points[from];
          const end = points[to];
          context.beginPath();
          context.moveTo(start.px, start.py);
          context.lineTo(end.px, end.py);
          context.stroke();

          const progress = reducedMotion ? 0.5 : ((time * 0.00004 * (index % 3 + 1)) + index * 0.17 + groupIndex * 0.11) % 1;
          const packetX = start.px + (end.px - start.px) * progress;
          const packetY = start.py + (end.py - start.py) * progress;
          context.fillStyle = "rgba(169, 199, 178, 0.72)";
          context.fillRect(packetX - 1.5, packetY - 1.5, 3, 3);
        });
      });

      pointGroups.flat().forEach((node) => {
          const distance = Math.hypot(pointer.x - node.px, pointer.y - node.py);
          const active = distance < 150;
          context.fillStyle = active ? "rgba(244, 246, 243, 0.95)" : "rgba(169, 199, 178, 0.68)";
          context.beginPath();
          context.arc(node.px, node.py, active ? 4 : 2.5, 0, Math.PI * 2);
          context.fill();
          context.font = "9px IBM Plex Mono, monospace";
          context.fillStyle = active ? "rgba(244, 246, 243, 0.82)" : "rgba(244, 246, 243, 0.28)";
          context.fillText(node.label, node.px + 10, node.py + 4);
      });

      if (!reducedMotion) frame = requestAnimationFrame(draw);
    };

    const resizeObserver = new ResizeObserver(() => {
      resize();
      if (reducedMotion) draw();
    });
    if (section) resizeObserver.observe(section);
    window.addEventListener("pointermove", (event) => {
      if (!section) return;
      const bounds = section.getBoundingClientRect();
      pointer = { x: event.clientX - bounds.left, y: event.clientY - bounds.top };
    }, { signal: controller.signal, passive: true });
    controller.signal.addEventListener("abort", () => {
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
    });
    resize();
    draw();
  }
</script>