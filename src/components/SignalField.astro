---
// 3D Particle Stream & Constellation Header:
// Renders a 3D sweeping logarithmic particle ribbon with dynamic constellation links,
// additive glow sprites, anamorphic optical lens flares, and spring-physics cursor smear.
---

<signal-field class="signal-field" aria-hidden="true">
  <canvas data-signal-field></canvas>
  <div class="signal-field__fade"></div>
</signal-field>

<script>
  type StreamParticle = {
    u: number;
    across: number;
    depth: number;
    speed: number;
    colorIndex: number;
    size: number;
    hero: boolean;
    anchor: boolean;
    phase: number;
    vx: number;
    vy: number;
    ox: number;
    oy: number;
  };

  class SignalFieldElement extends HTMLElement {
    private controller?: AbortController;
    private resizeObserver?: ResizeObserver;
    private visibilityObserver?: IntersectionObserver;
    private themeObserver?: MutationObserver;
    private frame = 0;
    private visible = true;

    connectedCallback() {
      const canvas = this.querySelector("[data-signal-field]");
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext("2d", { alpha: true });
      if (!context) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const pointer = { x: -9999, y: -9999, vx: 0, vy: 0, active: false };
      let width = 0;
      let height = 0;
      let light = document.documentElement.dataset.theme === "light";

      let state = 135792468;
      const rand = () => {
        state = (state * 1664525 + 1013904223) >>> 0;
        return state / 0x100000000;
      };
      const gauss = () => (rand() + rand() + rand() + rand() - 2) * 0.5;

      const count = 1100;
      const particles: StreamParticle[] = Array.from({ length: count }, (_, i) => {
        const r = rand();
        const colorIndex = r < 0.48 ? 0 : r < 0.66 ? 1 : r < 0.82 ? 2 : r < 0.9 ? 3 : r < 0.96 ? 4 : 5;
        const isHero = i < 5;
        return {
          u: i / count,
          across: isHero ? 0 : gauss() * 0.26,
          depth: isHero ? 0 : gauss() * 0.25,
          speed: 0.038 + rand() * 0.035,
          colorIndex: isHero ? (i % 2 === 0 ? 1 : 3) : colorIndex,
          size: isHero ? 3.6 : rand() > 0.92 ? 2.15 : rand() > 0.68 ? 1.38 : 0.82,
          hero: isHero,
          anchor: i % 22 === 0,
          phase: rand() * Math.PI * 2,
          vx: 0,
          vy: 0,
          ox: 0,
          oy: 0,
        };
      });

      const getColors = (): [number, number, number][] =>
        light
          ? [
              [15, 23, 34],
              [15, 108, 189],
              [37, 99, 235],
              [217, 95, 14],
              [234, 124, 43],
              [24, 121, 91],
            ]
          : [
              [245, 246, 251],
              [109, 203, 244],
              [122, 177, 254],
              [248, 121, 21],
              [250, 153, 76],
              [125, 211, 176],
            ];

      let sprites: HTMLCanvasElement[] = [];
      const buildSprites = () => {
        sprites = getColors().map(([r, g, b]) => {
          const size = 48;
          const off = document.createElement("canvas");
          off.width = size;
          off.height = size;
          const ctx = off.getContext("2d");
          if (!ctx) return off;
          const half = size / 2;
          const grad = ctx.createRadialGradient(half, half, 0, half, half, half);
          grad.addColorStop(0, "rgba(255, 255, 255, 1)");
          grad.addColorStop(0.18, `rgba(${r}, ${g}, ${b}, 0.92)`);
          grad.addColorStop(0.45, `rgba(${r}, ${g}, ${b}, 0.32)`);
          grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, size, size);
          return off;
        });
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        width = Math.max(1, bounds.width);
        height = Math.max(1, bounds.height);
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      buildSprites();

      const draw = (time = 0) => {
        if (width === 0 || height === 0) return;
        context.clearRect(0, 0, width, height);

        const still = reducedMotion.matches;
        const seconds = still ? 8 : time / 1000;
        const colors = getColors();

        pointer.vx *= 0.85;
        pointer.vy *= 0.85;

        // Ambient deep-space backdrop glow on the right half of the header
        const amb = context.createRadialGradient(
          width * 0.72,
          height * 0.45,
          0,
          width * 0.72,
          height * 0.45,
          Math.max(width, height) * 0.55,
        );
        if (light) {
          amb.addColorStop(0, "rgba(15, 108, 189, 0.10)");
          amb.addColorStop(1, "rgba(238, 242, 246, 0)");
        } else {
          amb.addColorStop(0, "rgba(35, 67, 95, 0.42)");
          amb.addColorStop(0.5, "rgba(248, 121, 21, 0.06)");
          amb.addColorStop(1, "rgba(3, 5, 8, 0)");
        }
        context.fillStyle = amb;
        context.fillRect(0, 0, width, height);

        context.save();
        context.globalCompositeOperation = light ? "source-over" : "lighter";

        const flares: { x: number; y: number; color: [number, number, number] }[] = [];
        const anchors: { x: number; y: number }[] = [];

        for (let i = 0; i < particles.length; i += 1) {
          const p = particles[i]!;
          const t = ((p.u + seconds * p.speed) % 1 + 1) % 1;
          const angle = t * Math.PI * 2.2 - 0.6;
          const baseX = t * width * 1.1 - width * 0.05;
          const waveY =
            height * 0.48 +
            Math.sin(angle + seconds * 0.35) * height * 0.24 +
            Math.cos(angle * 1.7 - seconds * 0.22) * height * 0.1;

          const perspective = 2.6 / Math.max(0.8, 2.6 - (p.depth + Math.sin(angle) * 0.35));
          let sx = baseX + p.across * 95 * perspective + p.ox;
          let sy = waveY + p.across * 115 * perspective + p.oy;

          if (pointer.active && !still) {
            const dx = sx - pointer.x;
            const dy = sy - pointer.y;
            const dSq = dx * dx + dy * dy;
            if (dSq < 155 * 155 && dSq > 1) {
              const d = Math.sqrt(dSq);
              const f = Math.pow(1 - d / 155, 2);
              p.vx += (dx / d) * f * 1.65 + pointer.vx * f * 0.12;
              p.vy += (dy / d) * f * 1.65 + pointer.vy * f * 0.12;
            }
          }

          p.vx += -p.ox * 0.08;
          p.vy += -p.oy * 0.08;
          p.vx *= 0.84;
          p.vy *= 0.84;
          p.ox += p.vx;
          p.oy += p.vy;

          sx = baseX + p.across * 95 * perspective + p.ox;
          sy = waveY + p.across * 115 * perspective + p.oy;

          const env = Math.sin(t * Math.PI);
          const twinkle = still ? 0.8 : 0.65 + Math.sin(seconds * 2.5 + p.phase) * 0.35;
          const alpha = env * twinkle * (light ? 0.65 : 0.88);
          const r = p.size * perspective * 3.8;
          const sprite = sprites[p.colorIndex] ?? sprites[0]!;

          context.globalAlpha = alpha;
          context.drawImage(sprite, sx - r, sy - r, r * 2, r * 2);

          if (p.anchor) {
            anchors.push({ x: sx, y: sy });
          }

          if (p.hero) {
            flares.push({ x: sx, y: sy, color: colors[p.colorIndex] ?? colors[0]! });
          }
        }

        // Subtle constellation filaments connecting nearby anchor stars
        context.lineWidth = 0.65;
        for (let i = 0; i < anchors.length; i += 1) {
          const a = anchors[i]!;
          for (let j = i + 1; j < anchors.length; j += 1) {
            const b = anchors[j]!;
            const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist < 115) {
              const strength = (1 - dist / 115) * (light ? 0.16 : 0.22);
              context.strokeStyle = light ? `rgba(15, 108, 189, ${strength})` : `rgba(109, 203, 244, ${strength})`;
              context.beginPath();
              context.moveTo(a.x, a.y);
              context.lineTo(b.x, b.y);
              context.stroke();
            }
          }
        }

        flares.forEach(({ x, y, color }) => {
          const [r, g, b] = color;
          const sw = 185;
          const grad = context.createLinearGradient(x - sw, y, x + sw, y);
          grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0)`);
          grad.addColorStop(0.5, "rgba(255, 255, 255, 0.68)");
          grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
          context.strokeStyle = grad;
          context.lineWidth = 1.25;
          context.beginPath();
          context.moveTo(x - sw, y);
          context.lineTo(x + sw, y);
          context.stroke();
        });

        context.restore();
        context.globalAlpha = 1;
        if (!still && this.visible) this.frame = requestAnimationFrame(draw);
      };

      const restart = () => {
        cancelAnimationFrame(this.frame);
        draw(performance.now());
      };

      this.resizeObserver = new ResizeObserver(() => {
        resize();
        restart();
      });
      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry?.isIntersecting ?? true;
        if (this.visible) restart();
        else cancelAnimationFrame(this.frame);
      });
      this.themeObserver = new MutationObserver(() => {
        light = document.documentElement.dataset.theme === "light";
        buildSprites();
        restart();
      });

      this.resizeObserver.observe(this);
      this.visibilityObserver.observe(this);
      this.themeObserver.observe(document.documentElement, { attributeFilter: ["data-theme"] });

      const parentSection = this.parentElement ?? this;
      parentSection.addEventListener(
        "pointermove",
        (event) => {
          if (reducedMotion.matches) return;
          const bounds = this.getBoundingClientRect();
          const nx = event.clientX - bounds.left;
          const ny = event.clientY - bounds.top;
          if (pointer.active) {
            pointer.vx = nx - pointer.x;
            pointer.vy = ny - pointer.y;
          }
          pointer.x = nx;
          pointer.y = ny;
          pointer.active = true;
        },
        { signal },
      );
      parentSection.addEventListener(
        "pointerleave",
        () => {
          pointer.active = false;
        },
        { signal },
      );
      reducedMotion.addEventListener("change", restart, { signal });

      resize();
      restart();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.controller?.abort();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
      this.themeObserver?.disconnect();
    }
  }

  if (!customElements.get("signal-field")) {
    customElements.define("signal-field", SignalFieldElement);
  }
</script>

<style>
  .signal-field {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }

  .signal-field canvas {
    display: block;
    height: 100%;
    width: 100%;
  }

  .signal-field__fade {
    background:
      radial-gradient(circle at 16% 50%, color-mix(in srgb, var(--theme-canvas) 78%, transparent) 0%, transparent 55%),
      linear-gradient(180deg, transparent 58%, var(--theme-canvas) 100%);
    inset: 0;
    pointer-events: none;
    position: absolute;
  }
</style>
