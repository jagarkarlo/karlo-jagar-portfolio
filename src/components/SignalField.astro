---
// Bespoke 3D Cosmic Scene Engine for Portfolio Pages:
// Each page receives its own tailored 3D mathematical particle formation,
// interactive 3D drag/pointer rotation, spring-physics cursor smear,
// click shockwaves, and anamorphic optical lens flares:
// - "globe"   (About)    : 3D Geodesic Orbital Sphere + Great-Circle Trajectory Arcs (Zagreb · Varaždin · Porto)
// - "cluster" (Work)     : 3D 7-Spoke Kubernetes / Platform Helm Topology + Satellite Pods
// - "helix"   (Blog)     : 3D Double-Helix Knowledge Stream + Rung Bridges (Blog & Case Studies)
// - "bridge"  (Contact)  : 3D Dual-Core Binary Star & Figure-Eight Entangled Relay Stream
// - "radar"   (Search)   : 3D Concentric Radar Pulse Lattice & Scanning Beam
interface Props {
  scene?: "globe" | "cluster" | "helix" | "bridge" | "radar";
}

const { scene = "globe" } = Astro.props;
---

<signal-field class="signal-field" data-scene={scene} aria-hidden="true">
  <div class="signal-field__ambient"></div>
  <canvas data-signal-field></canvas>
</signal-field>

<script>
  type SceneKind = "globe" | "cluster" | "helix" | "bridge" | "radar";

  type SceneParticle = {
    u: number;
    v: number;
    across: number;
    depth: number;
    speed: number;
    bx: number;
    by: number;
    bz: number;
    ex: number;
    ey: number;
    ez: number;
    colorIndex: number;
    size: number;
    hero: boolean;
    anchor: boolean;
    arcGroup: number;
    phase: number;
    vx: number;
    vy: number;
    ox: number;
    oy: number;
  };

  type Shockwave = {
    x: number;
    y: number;
    born: number;
    color: [number, number, number];
  };

  const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const smootherstep = (edge0: number, edge1: number, x: number) => {
    const t = clamp((x - edge0) / Math.max(1e-5, edge1 - edge0), 0, 1);
    return t * t * t * (t * (t * 6 - 15) + 10);
  };

  class SignalFieldElement extends HTMLElement {
    private controller?: AbortController;
    private resizeObserver?: ResizeObserver;
    private themeObserver?: MutationObserver;
    private frame = 0;

    connectedCallback() {
      const canvas = this.querySelector("[data-signal-field]");
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext("2d", { alpha: true });
      if (!context) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const scene = (this.dataset.scene as SceneKind) || "globe";
      let width = 0;
      let height = 0;
      let dpr = 1;
      let docScrollMax = 1;
      let rawScroll = 0;
      let pageVisible = document.visibilityState !== "hidden";
      let light = document.documentElement.dataset.theme === "light";
      let introStart: number | null = null;

      const defaultSpinX = scene === "radar" ? 0.68 : scene === "cluster" ? 0.44 : 0.32;
      const defaultSpinY = scene === "helix" ? -0.35 : -0.24;
      let spinX = defaultSpinX;
      let spinY = defaultSpinY;
      let userRotX = 0;
      let userRotY = 0;
      let dragging = false;
      let dragLastX = 0;
      let dragLastY = 0;
      let dragDistance = 0;

      const pointer = {
        x: -9999,
        y: -9999,
        vx: 0,
        vy: 0,
        normX: 0,
        normY: 0,
        active: false,
        pressed: false,
      };

      const shockwaves: Shockwave[] = [];
      let overdriveUntil = 0;

      let seedState =
        scene === "globe"
          ? 202601
          : scene === "cluster"
            ? 202602
            : scene === "helix"
              ? 202603
              : scene === "bridge"
                ? 202604
                : 202605;
      const rand = () => {
        seedState = (seedState * 1664525 + 1013904223) >>> 0;
        return seedState / 0x100000000;
      };
      const gauss = () => (rand() + rand() + rand() + rand() - 2) * 0.5;

      const isMobile = () => window.innerWidth < 768;
      const count = isMobile() ? 650 : 1150;

      const pickColor = (r: number) => {
        if (r < 0.46) return 0;
        if (r < 0.64) return 1;
        if (r < 0.80) return 2;
        if (r < 0.88) return 3;
        if (r < 0.94) return 4;
        return 5;
      };

      const buildParticleGeometry = (i: number): {
        bx: number;
        by: number;
        bz: number;
        ex: number;
        ey: number;
        ez: number;
        arcGroup: number;
      } => {
        const u = i / count;
        const v = rand();
        const g1 = gauss();
        const g2 = gauss();

        if (scene === "globe") {
          const sphereCut = Math.floor(count * 0.68);
          const arcCut = Math.floor(count * 0.86);
          if (i < sphereCut) {
            const phi = Math.acos(1 - (2 * (i + 0.5)) / sphereCut);
            const theta = Math.PI * (1 + Math.sqrt(5)) * i;
            const r = 0.78 + g1 * 0.025;
            const bx = r * Math.sin(phi) * Math.cos(theta);
            const by = r * Math.cos(phi);
            const bz = r * Math.sin(phi) * Math.sin(theta);
            return { bx, by, bz, ex: bx * 1.12, ey: by * 1.12, ez: bz * 1.12, arcGroup: 0 };
          } else if (i < arcCut) {
            const sub = (i - sphereCut) / Math.max(1, arcCut - sphereCut);
            const arcIdx = i % 3;
            const t = sub * Math.PI - Math.PI * 0.5;
            const tilt = (arcIdx - 1) * 0.58;
            const r = 0.82 + Math.cos(t) * 0.28;
            const x0 = Math.sin(t) * r;
            const y0 = Math.sin(t * 0.8) * Math.sin(tilt) * r;
            const z0 = Math.cos(t) * r;
            return { bx: x0, by: y0, bz: z0, ex: x0, ey: y0 * 1.2, ez: z0, arcGroup: arcIdx + 1 };
          } else {
            const sub = (i - arcCut) / Math.max(1, count - arcCut);
            const angle = sub * Math.PI * 2;
            const r = 1.16 + g1 * 0.04;
            const bx = Math.cos(angle) * r;
            const by = Math.sin(angle) * 0.24 + g2 * 0.02;
            const bz = Math.sin(angle) * r;
            return { bx, by, bz, ex: bx * 0.94, ey: by, ez: bz * 0.94, arcGroup: 4 };
          }
        }

        if (scene === "cluster") {
          const spokes = 7;
          let bx = 0;
          let by = 0;
          let bz = 0;
          if (u < 0.44) {
            const sub = u / 0.44;
            const outer = sub < 0.72;
            const ringR = outer ? 0.82 : 0.26;
            const angle = (outer ? sub / 0.72 : (sub - 0.72) / 0.28) * Math.PI * 2;
            const sector = (Math.PI * 2) / spokes;
            const localA = ((angle % sector) + sector) % sector - sector * 0.5;
            const poly = outer ? Math.cos(sector * 0.5) / Math.max(0.5, Math.cos(localA * 0.65)) : 1;
            const r = ringR * poly + g1 * 0.032;
            bx = Math.cos(angle) * r;
            by = Math.sin(angle) * r;
            bz = Math.sin(angle * spokes) * 0.1 + g2 * 0.05;
          } else if (u < 0.86) {
            const sub = (u - 0.44) / 0.42;
            const spokeIdx = Math.min(spokes - 1, Math.floor(sub * spokes));
            const radialT = sub * spokes - spokeIdx;
            const angle = (spokeIdx / spokes) * Math.PI * 2 - Math.PI * 0.5;
            const r = lerp(0.24, 1.0, radialT);
            const knob = radialT > 0.84 ? 2.1 : 0.7;
            bx = Math.cos(angle) * r + -Math.sin(angle) * g1 * 0.028 * knob;
            by = Math.sin(angle) * r + Math.cos(angle) * g1 * 0.028 * knob;
            bz = Math.cos(radialT * Math.PI) * 0.12 + g2 * 0.05;
          } else {
            const angle = u * Math.PI * 14;
            const r = 1.15 + g1 * 0.08;
            bx = Math.cos(angle) * r;
            by = Math.sin(angle) * r;
            bz = (v - 0.5) * 0.5;
          }

          const kt = u * Math.PI * 2;
          const ex = (Math.sin(kt) + 2 * Math.sin(2 * kt)) * 0.32 + g1 * 0.04;
          const ey = (Math.cos(kt) - 2 * Math.cos(2 * kt)) * 0.32 + g2 * 0.04;
          const ez = -Math.sin(3 * kt) * 0.35;
          return { bx, by, bz, ex, ey, ez, arcGroup: i % spokes };
        }

        if (scene === "helix") {
          const turns = 3.2;
          const strandCut = Math.floor(count * 0.74);
          if (i < strandCut) {
            const strand = i % 2 === 0 ? 0 : Math.PI;
            const sub = i / strandCut;
            const y = (sub - 0.5) * 2.1;
            const angle = sub * Math.PI * 2 * turns + strand;
            const r = 0.56 + g1 * 0.045;
            const bx = Math.cos(angle) * r;
            const by = y;
            const bz = Math.sin(angle) * r + g2 * 0.045;
            return { bx, by, bz, ex: bx * 1.15, ey: by, ez: bz * 1.15, arcGroup: i % 2 };
          } else {
            const rungCount = 22;
            const sub = (i - strandCut) / Math.max(1, count - strandCut);
            const rungIdx = Math.floor(sub * rungCount);
            const acrossT = (sub * rungCount - rungIdx) * 2 - 1;
            const yNorm = (rungIdx + 0.5) / rungCount;
            const y = (yNorm - 0.5) * 2.0;
            const angle = yNorm * Math.PI * 2 * turns;
            const r = 0.55 * acrossT;
            const bx = Math.cos(angle) * r;
            const by = y + g1 * 0.015;
            const bz = Math.sin(angle) * r;
            return { bx, by, bz, ex: bx, ey: by, ez: bz, arcGroup: 2 };
          }
        }

        if (scene === "bridge") {
          const coreCut = Math.floor(count * 0.28);
          if (i < coreCut) {
            const leftCore = i % 2 === 0;
            const centerX = leftCore ? -0.58 : 0.58;
            const phi = Math.acos(1 - 2 * v);
            const theta = u * Math.PI * 24;
            const r = Math.pow(rand(), 0.6) * 0.26;
            const bx = centerX + r * Math.sin(phi) * Math.cos(theta);
            const by = r * Math.cos(phi);
            const bz = r * Math.sin(phi) * Math.sin(theta);
            return { bx, by, bz, ex: bx, ey: by, ez: bz, arcGroup: leftCore ? 1 : 2 };
          } else {
            const sub = (i - coreCut) / Math.max(1, count - coreCut);
            const t = sub * Math.PI * 2;
            const denom = 1 + Math.sin(t) * Math.sin(t);
            const scaleL = 1.12;
            const bx = (scaleL * Math.cos(t)) / denom + g1 * 0.05;
            const by = (scaleL * Math.sin(t) * Math.cos(t)) / denom + g2 * 0.05;
            const bz = Math.sin(t * 2) * 0.28 + g1 * 0.04;
            return { bx, by, bz, ex: bx * 1.05, ey: by * 1.05, ez: bz, arcGroup: 0 };
          }
        }

        const ringCount = 7;
        const ringIdx = i % ringCount;
        const r = ((ringIdx + 1) / ringCount) * 1.05 + g1 * 0.02;
        const angle = u * Math.PI * 2 * ringCount;
        const bx = Math.cos(angle) * r;
        const by = Math.sin(angle) * r;
        const bz = Math.cos(r * Math.PI * 2.5) * 0.16 + g2 * 0.03;
        return { bx, by, bz, ex: bx, ey: by, ez: bz, arcGroup: ringIdx };
      };

      const particles: SceneParticle[] = Array.from({ length: count }, (_, i) => {
        const r = rand();
        const isHero = i % Math.max(1, Math.floor(count / 7)) === 0;
        const geom = buildParticleGeometry(i);
        let colorIndex = pickColor(r);
        if (isHero) colorIndex = i % 2 === 0 ? 1 : 3;
        else if (scene === "bridge" && geom.arcGroup === 2 && r > 0.35) colorIndex = 3;
        else if (scene === "globe" && geom.arcGroup > 0 && geom.arcGroup < 4) colorIndex = geom.arcGroup === 2 ? 3 : 1;

        return {
          u: i / count,
          v: rand(),
          across: gauss() * 0.15,
          depth: gauss() * 0.15,
          speed: 0.05 + rand() * 0.04,
          ...geom,
          colorIndex,
          size: isHero ? 3.8 : rand() > 0.92 ? 2.4 : rand() > 0.65 ? 1.55 : 0.95,
          hero: isHero,
          anchor: i % 34 === 0,
          phase: rand() * Math.PI * 2,
          vx: 0,
          vy: 0,
          ox: 0,
          oy: 0,
        };
      });

      const getColors = (): [number, number, number][] =>
        light
          ? [
              [30, 58, 138],   // #1E3A8A celestial indigo
              [11, 107, 203],  // #0B6BCB royal cyan-blue
              [109, 40, 217],  // #6D28D9 deep violet
              [217, 95, 14],   // #D95F0E solar amber
              [234, 88, 12],   // #EA580C warm tangerine
              [13, 148, 136],  // #0D9488 emerald teal
            ]
          : [
              [245, 246, 251],
              [109, 203, 244],
              [122, 177, 254],
              [248, 121, 21],
              [250, 153, 76],
              [125, 211, 176],
            ];

      let sprites: HTMLCanvasElement[] = [];
      const buildSprites = () => {
        sprites = getColors().map(([r, g, b], idx) => {
          const size = 28;
          const off = document.createElement("canvas");
          off.width = size;
          off.height = size;
          const ctx = off.getContext("2d");
          if (!ctx) return off;
          const half = size / 2;
          const grad = ctx.createRadialGradient(half, half, 0, half, half, half);
          if (light) {
            const coreAlpha = idx === 0 ? 0.88 : 1;
            grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${coreAlpha})`);
            grad.addColorStop(0.28, `rgba(${r}, ${g}, ${b}, 0.72)`);
            grad.addColorStop(0.58, `rgba(${r}, ${g}, ${b}, 0.18)`);
            grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
          } else {
            grad.addColorStop(0, "rgba(255, 255, 255, 1)");
            grad.addColorStop(0.18, `rgba(${r}, ${g}, ${b}, 0.94)`);
            grad.addColorStop(0.45, `rgba(${r}, ${g}, ${b}, 0.32)`);
            grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
          }
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, size, size);
          return off;
        });
      };

      const updateScrollMetrics = () => {
        docScrollMax = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        rawScroll = clamp(window.scrollY / docScrollMax, 0, 1);
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 1.35);
        width = Math.max(1, bounds.width);
        height = Math.max(1, bounds.height);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        updateScrollMetrics();
      };

      buildSprites();

      let smoothedScroll = 0;

      const triggerShockwave = (x: number, y: number) => {
        const colors = getColors();
        const colorPick = colors[(shockwaves.length + 1) % colors.length] ?? colors[1]!;
        shockwaves.push({ x, y, born: performance.now() / 1000, color: colorPick });
        if (shockwaves.length > 5) shockwaves.shift();
      };

      const activateOverdrive = (cx: number, cy: number) => {
        const nowSec = performance.now() / 1000;
        overdriveUntil = nowSec + 3.4;
        triggerShockwave(cx, cy);
        setTimeout(() => triggerShockwave(cx, cy), 110);
        particles.forEach((p, idx) => {
          const angle = (idx / particles.length) * Math.PI * 18 + p.phase;
          const burst = 9 + (idx % 5) * 3.2;
          p.vx += Math.cos(angle) * burst;
          p.vy += Math.sin(angle) * burst;
        });
      };

      const drawAnamorphicFlare = (
        fx: number,
        fy: number,
        intensity: number,
        color: [number, number, number],
        primary: boolean,
      ) => {
        if (intensity <= 0.02) return;
        const [r, g, b] = color;
        const coreColor = light ? `${r}, ${g}, ${b}` : "255, 255, 255";
        const alphaScale = light ? 0.52 : 1;
        context.save();
        context.globalCompositeOperation = light ? "source-over" : "lighter";

        const haloR = (primary ? 120 : 62) * (0.7 + intensity * 0.4);
        const halo = context.createRadialGradient(fx, fy, 0, fx, fy, haloR);
        halo.addColorStop(0, `rgba(${coreColor}, ${0.5 * intensity * alphaScale})`);
        halo.addColorStop(0.22, `rgba(${r}, ${g}, ${b}, ${0.28 * intensity * alphaScale})`);
        halo.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        context.fillStyle = halo;
        context.beginPath();
        context.arc(fx, fy, haloR, 0, Math.PI * 2);
        context.fill();

        const streakW = (primary ? Math.min(width * 0.4, 430) : 165) * (0.65 + intensity * 0.35);
        const hGrad = context.createLinearGradient(fx - streakW, fy, fx + streakW, fy);
        hGrad.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0)`);
        hGrad.addColorStop(0.38, `rgba(${r}, ${g}, ${b}, ${0.22 * intensity * alphaScale})`);
        hGrad.addColorStop(0.5, `rgba(${coreColor}, ${0.68 * intensity * alphaScale})`);
        hGrad.addColorStop(0.62, `rgba(${r}, ${g}, ${b}, ${0.22 * intensity * alphaScale})`);
        hGrad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        context.strokeStyle = hGrad;
        context.lineWidth = primary ? 1.6 : 1.05;
        context.beginPath();
        context.moveTo(fx - streakW, fy);
        context.lineTo(fx + streakW, fy);
        context.stroke();

        const streakH = (primary ? 95 : 44) * (0.65 + intensity * 0.35);
        const vGrad = context.createLinearGradient(fx, fy - streakH, fx, fy + streakH);
        vGrad.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0)`);
        vGrad.addColorStop(0.5, `rgba(${coreColor}, ${0.44 * intensity * alphaScale})`);
        vGrad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
        context.strokeStyle = vGrad;
        context.lineWidth = 1.0;
        context.beginPath();
        context.moveTo(fx, fy - streakH);
        context.lineTo(fx, fy + streakH);
        context.stroke();

        context.restore();
      };

      const draw = (now = performance.now()) => {
        if (width === 0 || height === 0) return;
        if (introStart === null) introStart = now;
        const still = reducedMotion.matches;
        const seconds = still ? 10 : now / 1000;
        const introElapsed = still ? 4 : Math.max(0, (now - introStart) / 1000);
        const introT = clamp(introElapsed / 2.2, 0, 1);
        const introEase = smootherstep(0, 1, introT);
        const colors = getColors();

        smoothedScroll = still ? rawScroll : lerp(smoothedScroll, rawScroll, 0.085);

        // Accumulate user drag offset on top of gentle ambient rotation (never snaps back)
        const overdriveBoost = seconds < overdriveUntil ? (overdriveUntil - seconds) * 0.9 : 0;
        if (overdriveBoost > 0 && !still) {
          userRotY += 0.045 * overdriveBoost;
        }
        const ambientY =
          defaultSpinY +
          (still ? 0 : seconds * (scene === "globe" ? 0.11 : 0.085)) +
          (pointer.active && !dragging ? pointer.normX * 0.08 : 0);
        const ambientX =
          defaultSpinX +
          (still ? 0 : Math.cos(seconds * 0.18) * 0.07) +
          (pointer.active && !dragging ? pointer.normY * 0.06 : 0);
        const targetSpinY = ambientY + userRotY;
        const targetSpinX = clamp(ambientX + userRotX, -1.15, 1.15);
        spinX = lerp(spinX, targetSpinX, 0.1);
        spinY = lerp(spinY, targetSpinY, 0.1);

        pointer.vx *= 0.86;
        pointer.vy *= 0.86;

        context.clearRect(0, 0, width, height);

        const scale = Math.min(width, height) * (width < 640 ? 0.42 : 0.45);
        const cx = width >= 1024 ? width * (scene === "bridge" || scene === "radar" ? 0.56 : 0.64) : width * 0.5;
        const cy = height * 0.46;
        const fov = 3.2;

        const ambR = scale * 1.35;
        const amb = context.createRadialGradient(cx, cy, 0, cx, cy, ambR);
        if (light) {
          amb.addColorStop(0, "rgba(15, 108, 189, 0.11)");
          amb.addColorStop(0.5, "rgba(109, 40, 217, 0.05)");
          amb.addColorStop(1, "rgba(238, 242, 246, 0)");
        } else {
          amb.addColorStop(0, "rgba(35, 67, 95, 0.44)");
          amb.addColorStop(0.42, "rgba(22, 42, 74, 0.22)");
          amb.addColorStop(0.75, "rgba(248, 121, 21, 0.06)");
          amb.addColorStop(1, "rgba(3, 5, 8, 0)");
        }
        context.fillStyle = amb;
        context.fillRect(0, 0, width, height);

        const cosX = Math.cos(spinX + smoothedScroll * 0.4);
        const sinX = Math.sin(spinX + smoothedScroll * 0.4);
        const cosY = Math.cos(spinY + smoothedScroll * 0.75);
        const sinY = Math.sin(spinY + smoothedScroll * 0.75);

        context.save();
        context.globalCompositeOperation = light ? "source-over" : "lighter";

        // Crisp 3D wireframe structure guides for each page's bespoke sculpture
        context.strokeStyle = light ? "rgba(15, 108, 189, 0.14)" : "rgba(109, 203, 244, 0.13)";
        context.lineWidth = 0.85;
        if (scene === "globe") {
          [-0.45, 0, 0.45].forEach((lat) => {
            const ringR = Math.sqrt(Math.max(0.01, 0.78 * 0.78 - lat * lat));
            context.beginPath();
            for (let s = 0; s <= 64; s += 1) {
              const a = (s / 64) * Math.PI * 2;
              const wx = Math.cos(a) * ringR * introEase;
              const wy = lat * introEase;
              const wz = Math.sin(a) * ringR * introEase;
              const rx1 = wx * cosY + wz * sinY;
              const rz1 = -wx * sinY + wz * cosY;
              const ry2 = wy * cosX - rz1 * sinX;
              const rz2 = wy * sinX + rz1 * cosX;
              const p = fov / Math.max(0.6, fov - rz2);
              const px = cx + rx1 * scale * p;
              const py = cy + ry2 * scale * p;
              if (s === 0) context.moveTo(px, py);
              else context.lineTo(px, py);
            }
            context.stroke();
          });
        } else if (scene === "cluster") {
          [0.26, 0.82].forEach((ringR) => {
            context.beginPath();
            for (let s = 0; s <= 7; s += 1) {
              const a = (s / 7) * Math.PI * 2 - Math.PI * 0.5;
              const wx = Math.cos(a) * ringR * introEase;
              const wy = Math.sin(a) * ringR * introEase;
              const rx1 = wx * cosY;
              const rz1 = -wx * sinY;
              const ry2 = wy * cosX - rz1 * sinX;
              const rz2 = wy * sinX + rz1 * cosX;
              const p = fov / Math.max(0.6, fov - rz2);
              const px = cx + rx1 * scale * p;
              const py = cy + ry2 * scale * p;
              if (s === 0) context.moveTo(px, py);
              else context.lineTo(px, py);
            }
            context.stroke();
          });
        } else if (scene === "radar") {
          [0.3, 0.6, 0.9].forEach((ringR) => {
            context.beginPath();
            for (let s = 0; s <= 64; s += 1) {
              const a = (s / 64) * Math.PI * 2;
              const wx = Math.cos(a) * ringR * introEase;
              const wy = Math.sin(a) * ringR * introEase;
              const rx1 = wx * cosY;
              const rz1 = -wx * sinY;
              const ry2 = wy * cosX - rz1 * sinX;
              const rz2 = wy * sinX + rz1 * cosX;
              const p = fov / Math.max(0.6, fov - rz2);
              const px = cx + rx1 * scale * p;
              const py = cy + ry2 * scale * p;
              if (s === 0) context.moveTo(px, py);
              else context.lineTo(px, py);
            }
            context.stroke();
          });
        }

        const flares: { x: number; y: number; intensity: number; color: [number, number, number]; primary: boolean }[] = [];

        for (let i = 0; i < particles.length; i += 1) {
          const p = particles[i]!;

          let targetX = lerp(p.bx, p.ex, smoothedScroll);
          let targetY = lerp(p.by, p.ey, smoothedScroll);
          let targetZ = lerp(p.bz, p.ez, smoothedScroll);

          if (scene === "helix" && !still) {
            const wave = Math.sin(seconds * 1.4 + p.u * Math.PI * 4) * 0.05;
            targetX += wave;
            targetZ += Math.cos(seconds * 1.4 + p.u * Math.PI * 4) * 0.05;
          } else if (scene === "bridge" && p.arcGroup === 0 && !still) {
            const tFlow = ((p.u + seconds * p.speed * 0.45) % 1) * Math.PI * 2;
            const denom = 1 + Math.sin(tFlow) * Math.sin(tFlow);
            targetX = (1.12 * Math.cos(tFlow)) / denom + p.across * 0.25;
            targetY = (1.12 * Math.sin(tFlow) * Math.cos(tFlow)) / denom + p.depth * 0.25;
            targetZ = Math.sin(tFlow * 2) * 0.28;
          } else if (scene === "radar" && !still) {
            const rDist = Math.hypot(targetX, targetY);
            const ripple = Math.sin(rDist * 8 - seconds * 2.6) * 0.09;
            targetZ += ripple;
          }

          // Smooth convergence from outer cosmic field into the target 3D sculpture
          const scatterScale = 1 + (1 - introEase) * 1.15;
          const wx = targetX * scatterScale + Math.cos(p.phase) * (1 - introEase) * 0.45;
          const wy = targetY * scatterScale + Math.sin(p.phase) * (1 - introEase) * 0.45;
          const wz = targetZ * scatterScale;

          const rx1 = wx * cosY + wz * sinY;
          const rz1 = -wx * sinY + wz * cosY;
          const ry2 = wy * cosX - rz1 * sinX;
          const rz2 = wy * sinX + rz1 * cosX;

          const persp = fov / Math.max(0.6, fov - rz2);
          let sx = cx + rx1 * scale * persp + p.ox;
          let sy = cy + ry2 * scale * persp + p.oy;

          if (pointer.active && !still) {
            const dx = sx - pointer.x;
            const dy = sy - pointer.y;
            const dSq = dx * dx + dy * dy;
            const rad = pointer.pressed ? 220 : 160;
            if (dSq < rad * rad && dSq > 1) {
              const d = Math.sqrt(dSq);
              const f = Math.pow(1 - d / rad, 2);
              const push = (pointer.pressed ? 3.6 : 1.7) * f;
              p.vx += (dx / d) * push + pointer.vx * f * 0.14;
              p.vy += (dy / d) * push + pointer.vy * f * 0.14;
            }
          }

          for (let sIdx = 0; sIdx < shockwaves.length; sIdx += 1) {
            const sw = shockwaves[sIdx]!;
            const age = seconds - sw.born;
            if (age < 0 || age > 1.8) continue;
            const waveR = age * 440;
            const dx = sx - sw.x;
            const dy = sy - sw.y;
            const dist = Math.hypot(dx, dy) || 1;
            const band = Math.abs(dist - waveR);
            if (band < 44) {
              const strength = (1 - band / 44) * (1 - age / 1.8) * 2.2;
              p.vx += (dx / dist) * strength;
              p.vy += (dy / dist) * strength;
            }
          }

          p.vx += -p.ox * 0.085;
          p.vy += -p.oy * 0.085;
          p.vx *= 0.84;
          p.vy *= 0.84;
          p.ox += p.vx;
          p.oy += p.vy;

          sx = cx + rx1 * scale * persp + p.ox;
          sy = cy + ry2 * scale * persp + p.oy;

          if (sx < -40 || sx > width + 40 || sy < -40 || sy > height + 40) continue;

          const twinkle = still ? 0.85 : 0.66 + Math.sin(seconds * 2.4 + p.phase) * 0.34;
          const depthBoost = clamp((rz2 + 1.4) / 2.8, 0.35, 1.25);
          const alpha = clamp(twinkle * depthBoost * (light ? 0.76 : 0.9), 0.08, 1);
          const drawR = p.size * persp * (light ? 2.6 : 3.2);
          const sprite = sprites[p.colorIndex] ?? sprites[0]!;

          context.globalAlpha = alpha;
          context.drawImage(sprite, sx - drawR, sy - drawR, drawR * 2, drawR * 2);

          if (p.hero) {
            flares.push({
              x: sx,
              y: sy,
              intensity: clamp(alpha * persp * 0.72, 0.2, 0.95),
              color: colors[p.colorIndex] ?? colors[0]!,
              primary: i === 0,
            });
          }
        }

        for (let i = shockwaves.length - 1; i >= 0; i -= 1) {
          const sw = shockwaves[i]!;
          const age = seconds - sw.born;
          if (age > 1.8) {
            shockwaves.splice(i, 1);
            continue;
          }
          const progress = age / 1.8;
          const [r, g, b] = sw.color;
          context.beginPath();
          context.arc(sw.x, sw.y, progress * 440, 0, Math.PI * 2);
          context.strokeStyle = `rgba(${r}, ${g}, ${b}, ${(1 - progress) ** 1.6 * 0.55})`;
          context.lineWidth = 1.5;
          context.stroke();
        }

        context.restore();

        flares.forEach((f) => {
          drawAnamorphicFlare(f.x, f.y, f.intensity, f.color, f.primary);
        });

        context.globalAlpha = 1;
        if (!still && pageVisible) {
          this.frame = requestAnimationFrame(draw);
        }
      };

      const restart = () => {
        cancelAnimationFrame(this.frame);
        if (pageVisible) {
          this.frame = requestAnimationFrame(draw);
        }
      };

      window.addEventListener(
        "scroll",
        () => {
          rawScroll = clamp(window.scrollY / docScrollMax, 0, 1);
        },
        { passive: true, signal },
      );

      document.addEventListener(
        "visibilitychange",
        () => {
          pageVisible = document.visibilityState !== "hidden";
          if (pageVisible) restart();
          else cancelAnimationFrame(this.frame);
        },
        { signal },
      );

      window.addEventListener(
        "pointermove",
        (event) => {
          if (reducedMotion.matches) return;
          const nx = event.clientX;
          const ny = event.clientY;
          if (pointer.active) {
            pointer.vx = clamp(nx - pointer.x, -45, 45);
            pointer.vy = clamp(ny - pointer.y, -45, 45);
          }
          pointer.x = nx;
          pointer.y = ny;
          pointer.normX = (nx / Math.max(1, width)) * 2 - 1;
          pointer.normY = (ny / Math.max(1, height)) * 2 - 1;
          pointer.active = true;

          if (dragging) {
            const dx = nx - dragLastX;
            const dy = ny - dragLastY;
            dragDistance += Math.hypot(dx, dy);
            dragLastX = nx;
            dragLastY = ny;
            userRotY += dx * 0.0032;
            userRotX = clamp(userRotX + dy * 0.0032, -1.0, 1.0);
          }
        },
        { passive: true, signal },
      );

      window.addEventListener(
        "pointerdown",
        (event) => {
          if (reducedMotion.matches) return;
          pointer.pressed = true;
          dragDistance = 0;
          const target = event.target as HTMLElement | null;
          if (!target?.closest("a, button, input, dialog")) {
            window.getSelection()?.removeAllRanges();
            dragging = true;
            dragLastX = event.clientX;
            dragLastY = event.clientY;
          }
        },
        { passive: true, signal },
      );

      window.addEventListener(
        "pointerup",
        (event) => {
          const wasQuickClick = dragging && dragDistance < 6;
          pointer.pressed = false;
          dragging = false;
          if (wasQuickClick && !reducedMotion.matches) {
            triggerShockwave(event.clientX, event.clientY);
          }
        },
        { passive: true, signal },
      );

      window.addEventListener(
        "dblclick",
        (event) => {
          if (reducedMotion.matches) return;
          const target = event.target as HTMLElement | null;
          if (!target?.closest("a, button, input, dialog")) {
            activateOverdrive(event.clientX, event.clientY);
          }
        },
        { passive: true, signal },
      );

      window.addEventListener(
        "cosmos:overdrive",
        () => {
          activateOverdrive(width * 0.5, height * 0.46);
        },
        { signal },
      );

      window.addEventListener(
        "cosmos:supernova",
        () => {
          activateOverdrive(width * 0.5, height * 0.46);
        },
        { signal },
      );

      this.resizeObserver = new ResizeObserver(() => {
        resize();
        restart();
      });
      this.resizeObserver.observe(this);

      this.themeObserver = new MutationObserver(() => {
        light = document.documentElement.dataset.theme === "light";
        buildSprites();
        restart();
      });
      this.themeObserver.observe(document.documentElement, { attributeFilter: ["data-theme"] });

      reducedMotion.addEventListener("change", restart, { signal });

      resize();
      restart();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.controller?.abort();
      this.resizeObserver?.disconnect();
      this.themeObserver?.disconnect();
    }
  }

  if (!customElements.get("signal-field")) {
    customElements.define("signal-field", SignalFieldElement);
  }
</script>

<style>
  .signal-field {
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    z-index: 0;
  }

  .signal-field__ambient {
    background:
      radial-gradient(circle at 62% 44%, rgb(35 67 95 / 34%) 0%, transparent 60%),
      radial-gradient(circle at 70% 38%, rgb(248 121 21 / 8%) 0%, transparent 45%);
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  :global(:root[data-theme="light"]) .signal-field__ambient {
    background:
      radial-gradient(circle at 62% 44%, rgb(15 108 189 / 9%) 0%, transparent 60%),
      radial-gradient(circle at 70% 38%, rgb(217 95 14 / 5%) 0%, transparent 45%);
  }

  .signal-field canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
