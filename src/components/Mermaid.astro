---
// Renders any <pre class="mermaid"> produced by the markdown pipeline.
// Injects live multi-spectrum telemetry packet animations along every diagram edge
// and interactive node highlighting.
---

<script>
  let mermaidThemeObserver: MutationObserver | null = null;

  const renderMermaidDiagrams = async () => {
    mermaidThemeObserver?.disconnect();
    mermaidThemeObserver = null;
    const nodes = document.querySelectorAll<HTMLElement>("pre.mermaid");
    if (nodes.length === 0) return;

    const { default: mermaid } = await import("mermaid");

    const palette = () => {
      const styles = getComputedStyle(document.documentElement);
      const read = (name: string) => styles.getPropertyValue(name).trim();
      return {
        accent: read("--theme-accent"),
        cyan: read("--theme-cyan"),
        amber: read("--theme-amber"),
        canvas: read("--theme-canvas"),
        surface: read("--theme-surface"),
        raised: read("--theme-raised"),
        foreground: read("--theme-foreground"),
        border: read("--theme-border"),
        muted: read("--theme-muted"),
      };
    };

    const sources = [...nodes].map((node) => {
      if (!node.dataset.mermaidSource) {
        node.dataset.mermaidSource = node.textContent ?? "";
      }
      return node.dataset.mermaidSource;
    });

    const enhanceSvg = (container: HTMLElement, colors: string[]) => {
      const svgEl = container.querySelector("svg");
      if (!svgEl) return;

      const edgePaths = svgEl.querySelectorAll<SVGPathElement>("path.flowchart-link, .edgePaths path");
      edgePaths.forEach((path, idx) => {
        const clone = path.cloneNode(false) as SVGPathElement;
        clone.classList.add("mermaid-pulse-edge");
        const color = colors[idx % colors.length] ?? colors[0]!;
        clone.style.stroke = color;
        clone.style.animationDelay = `${(idx * 0.28).toFixed(2)}s`;
        path.parentElement?.appendChild(clone);
      });
    };

    const render = async () => {
      const theme = palette();
      const pulseColors = [theme.accent, theme.cyan, theme.amber];
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: "strict",
        fontFamily: "'IBM Plex Mono', ui-monospace, monospace",
        themeVariables: {
          background: theme.canvas,
          primaryColor: theme.raised,
          primaryTextColor: theme.foreground,
          primaryBorderColor: theme.accent,
          secondaryColor: theme.surface,
          tertiaryColor: theme.surface,
          lineColor: theme.muted,
          textColor: theme.foreground,
          mainBkg: theme.raised,
          nodeBorder: theme.accent,
          clusterBkg: theme.surface,
          clusterBorder: theme.border,
        },
      });

      for (const [index, node] of nodes.entries()) {
        const id = `mermaid-${Date.now()}-${index}`;
        const { svg } = await mermaid.render(id, sources[index] ?? "");
        node.innerHTML = svg;
        enhanceSvg(node, pulseColors);
      }
    };

    await render();
    mermaidThemeObserver = new MutationObserver(render);
    mermaidThemeObserver.observe(document.documentElement, {
      attributeFilter: ["data-theme"],
    });
  };

  document.addEventListener("astro:page-load", renderMermaidDiagrams);
  renderMermaidDiagrams();
</script>

<style is:global>
  pre.mermaid {
    background: color-mix(in srgb, var(--theme-surface) 75%, transparent);
    border: 1px solid var(--theme-border);
    display: grid;
    justify-items: center;
    overflow-x: auto;
    padding: 1.5rem 1.25rem;
    position: relative;
  }

  pre.mermaid::before {
    background: linear-gradient(90deg, var(--theme-accent), var(--theme-cyan), var(--theme-amber));
    content: "";
    height: 1px;
    inset-inline: 0;
    opacity: 0.65;
    position: absolute;
    top: 0;
  }

  pre.mermaid svg {
    height: auto;
    max-width: 100%;
  }

  pre.mermaid .node rect,
  pre.mermaid .node polygon,
  pre.mermaid .node circle,
  pre.mermaid .node path {
    transition: filter 180ms ease, stroke-width 180ms ease;
  }

  pre.mermaid .node:hover rect,
  pre.mermaid .node:hover polygon,
  pre.mermaid .node:hover circle,
  pre.mermaid .node:hover path {
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-accent) 55%, transparent));
    stroke-width: 2px;
  }

  .mermaid-pulse-edge {
    animation: mermaid-packet-flow 2.8s linear infinite;
    fill: none !important;
    pointer-events: none;
    stroke-dasharray: 10 86 !important;
    stroke-linecap: round;
    stroke-width: 2.2px !important;
  }

  @keyframes mermaid-packet-flow {
    from {
      stroke-dashoffset: 96;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mermaid-pulse-edge {
      animation: none;
      display: none;
    }
  }
</style>

