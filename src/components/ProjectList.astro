---
import type { Project } from "../data/projects";

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const visualBackgrounds: Record<Project["visual"], string> = {
  reliability: "bg-[#b6c9d2]",
  context: "bg-[#c9d7c9]",
  architecture: "bg-[#cbdff6]",
  game: "bg-[#1c3038]",
  security: "bg-[#c9d7c9]",
  desktop: "bg-white",
};
---

<div class="mx-auto max-w-[94rem] border-t border-paper/25">
  {projects.map((project) => (
    <article class="project-row grid grid-cols-1 gap-6 border-b border-paper/25 bg-ink/80 py-10 backdrop-blur-[2px] lg:gap-10 lg:py-12">
      <div class="flex justify-between font-mono text-[10px] uppercase lg:block">
        <span class="text-signal">{project.number}</span>
        <p class="m-0 text-paper/50 lg:mt-6 lg:[writing-mode:vertical-rl]">{project.category}</p>
      </div>
      <div class="self-start lg:pt-3">
        <h3 class="text-3xl leading-tight font-semibold sm:text-4xl">{project.title}</h3>
        <p class="mt-5 max-w-xl text-[15px] leading-6 text-paper/75">{project.summary}</p>
        <strong class="mt-5 block max-w-xl text-sm leading-6 font-medium text-signal">{project.outcome}</strong>
        <ul class="my-7 flex list-none flex-wrap gap-2 p-0" aria-label={`${project.title} technologies`}>{project.stack.map((item) => <li class="border border-paper/30 px-2 py-1.5 font-mono text-[8px] uppercase">{item}</li>)}</ul>
        <a class="font-mono text-[10px] uppercase underline underline-offset-4" href={project.href} target="_blank" rel="noreferrer">View public repository <span aria-hidden="true">↗</span></a>
      </div>
      <div class:list={["min-h-64 overflow-hidden lg:min-h-80", visualBackgrounds[project.visual]]} aria-hidden={project.image ? undefined : "true"}>
        {project.image ? (
          <img class:list={["h-full w-full", project.visual === "architecture" ? "object-contain p-6" : "object-cover [image-rendering:pixelated]"]} src={`${base}/${project.image}`} alt={project.visual === "game" ? "QuantumQuarry pixel-art game environment" : "Azure Kubernetes traffic-flow architecture diagram"} />
        ) : project.visual === "reliability" ? (
          <div class="pulse-visual"><span>service</span><i></i><i></i><i></i><b>recovered</b></div>
        ) : project.visual === "context" ? (
          <div class="context-visual"><span>assistant</span><i>GitLab</i><i>Jira</i><i>Docs</i><b>least privilege</b></div>
        ) : project.visual === "security" ? (
          <div class="network-visual"><i></i><i></i><i></i><i></i><b>policy / signal / action</b></div>
        ) : (
          <div class="monitor-visual"><span>3 services online</span><i></i><i></i><i></i><b>last known state retained</b></div>
        )}
      </div>
    </article>
  ))}
</div>