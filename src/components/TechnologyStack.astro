---
import { Icon } from "astro-icon/components";

const groups = [
  {
    label: "Platform & recovery",
    tone: "var(--theme-accent)",
    tools: [
      { name: "Kubernetes", icon: "simple-icons:kubernetes", href: "https://kubernetes.io/" },
      { name: "Argo CD", icon: "simple-icons:argo", href: "https://argo-cd.readthedocs.io/" },
      { name: "Docker", icon: "simple-icons:docker", href: "https://www.docker.com/" },
      { name: "PostgreSQL", icon: "simple-icons:postgresql", href: "https://www.postgresql.org/" },
    ],
  },
  {
    label: "Cloud & infrastructure",
    tone: "var(--theme-cyan)",
    tools: [
      { name: "Azure", icon: "simple-icons:microsoftazure", href: "https://azure.microsoft.com/" },
      { name: "Terraform", icon: "simple-icons:terraform", href: "https://www.terraform.io/" },
      { name: "Linux", icon: "simple-icons:linux", href: "https://www.linux.org/" },
      { name: "Ray / KubeRay", icon: "simple-icons:ray", href: "https://docs.ray.io/" },
    ],
  },
  {
    label: "Observability",
    tone: "var(--theme-amber)",
    tools: [
      { name: "Prometheus", icon: "simple-icons:prometheus", href: "https://prometheus.io/" },
      { name: "Grafana", icon: "simple-icons:grafana", href: "https://grafana.com/" },
      { name: "Loki", icon: "simple-icons:grafana", href: "https://grafana.com/oss/loki/" },
      { name: "OpenFlow / Ryu", icon: "lucide:network", href: "https://github.com/jagarkarlo/SDN-security-aspects" },
    ],
  },
  {
    label: "Languages & tooling",
    tone: "var(--theme-violet)",
    tools: [
      { name: "Go", icon: "simple-icons:go", href: "https://go.dev/" },
      { name: "TypeScript", icon: "simple-icons:typescript", href: "https://www.typescriptlang.org/" },
      { name: "Python", icon: "simple-icons:python", href: "https://www.python.org/" },
      { name: "GitLab & MCP", icon: "simple-icons:gitlab", href: "https://about.gitlab.com/" },
    ],
  },
];
---

<section class="border-y border-border/80 bg-canvas/65 px-6 py-20 backdrop-blur-md sm:px-10 lg:px-[6vw] lg:py-24" aria-labelledby="stack-title" data-reveal>
  <div class="mx-auto grid max-w-[94rem] gap-12 lg:grid-cols-[.6fr_1.4fr] lg:gap-20">
    <div>
      <p class="font-mono text-xs uppercase text-accent">02 // Platform Helm · Technical stack</p>
      <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="stack-title">Tools I use</h2>
      <p class="mt-6 max-w-sm text-sm leading-6 text-muted">The platform, cloud, telemetry, and development tools that recur across my work.</p>
    </div>
    <div class="grid border-t border-border sm:grid-cols-2">
      {groups.map((group) => (
        <section class="astra-card border-b border-border py-7 sm:px-7 sm:nth-[odd]:border-r sm:nth-[odd]:pl-0" style={`--stack-tone:${group.tone}`} aria-label={group.label}>
          <h3 class="mb-6 flex items-center gap-2.5 font-mono text-xs uppercase text-muted"><span class="size-1.5 rounded-full" style={`background:${group.tone}`}></span>{group.label}</h3>
          <ul class="grid list-none gap-4 p-0">
            {group.tools.map((tool) => (
              <li>
                <a class="group flex items-center gap-3 text-sm text-muted no-underline transition-all hover:translate-x-1 hover:text-foreground" href={tool.href} target="_blank" rel="noreferrer">
                  <Icon class="size-4 transition-transform group-hover:scale-110" style={`color:${group.tone}`} name={tool.icon} aria-hidden="true" />
                  <span>{tool.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
