const defaultTool = groups[0]!.tools[0]!;
---

<tech-stack-inspector class="block">
  <section class="border-y border-border/80 bg-canvas/80 px-6 py-20 sm:px-10 lg:px-[6vw] lg:py-24" aria-labelledby="stack-title" data-reveal>
    <div class="mx-auto grid max-w-[94rem] gap-12 lg:grid-cols-[.68fr_1.32fr] lg:gap-20">
      <div class="flex flex-col justify-between gap-8">
        <div>
          <p class="font-mono text-xs uppercase text-accent">Technical stack</p>
          <h2 class="mt-4 text-4xl leading-tight font-semibold sm:text-5xl" id="stack-title">Tools I use</h2>
          <p class="mt-6 max-w-sm text-sm leading-6 text-muted">
            Select or hover any tool to inspect how it is used across my repositories.
          </p>
        </div>

        <!-- Live interactive stack inspector card -->
        <div
          class="cosmos-card border border-border bg-surface/90 p-5"
          data-stack-detail
          aria-live="polite"
        >
          <div class="flex items-center justify-between gap-2 border-b border-border/70 pb-3">
            <span class="font-mono text-xs uppercase text-accent" data-detail-name>{defaultTool.name}</span>
            <span class="font-mono text-[11px] uppercase text-muted" data-detail-group>{groups[0]!.label}</span>
          </div>
          <p class="mt-3 mb-4 text-sm leading-6 text-muted" data-detail-summary>
            {defaultTool.summary}
          </p>
          <div class="flex flex-wrap items-center gap-2" data-detail-projects>
            {defaultTool.projects.map((proj) => (
              <a
                href={proj.href}
                class="border border-border bg-raised px-2.5 py-1 font-mono text-xs uppercase text-foreground no-underline transition-colors hover:border-accent hover:text-accent"
              >
                {proj.label} →
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="grid border-t border-border sm:grid-cols-2">
        {groups.map((group) => (
          <section class="cosmos-card border-b border-border py-7 sm:px-7 sm:nth-[odd]:border-r sm:nth-[odd]:pl-0" style={`--stack-tone:${group.tone}`} aria-label={group.label}>
            <h3 class="mb-6 flex items-center gap-2.5 font-mono text-xs uppercase text-muted">
              <span class="size-1.5 rounded-full" style={`background:${group.tone}`}></span>
              {group.label}
            </h3>
            <ul class="grid list-none gap-3 p-0">
              {group.tools.map((tool) => (
                <li>
                  <button
                    type="button"
                    data-stack-item
                    data-tool-name={tool.name}
                    data-tool-group={group.label}
                    data-tool-summary={tool.summary}
                    data-tool-projects={JSON.stringify(tool.projects)}
                    class="group flex w-full cursor-pointer items-center justify-between gap-3 border border-transparent bg-transparent px-2.5 py-1.5 text-left text-sm text-muted transition-all hover:border-border hover:bg-surface/70 hover:text-foreground"
                  >
                    <span class="flex items-center gap-3">
                      <Icon class="size-4 transition-transform group-hover:scale-110" style={`color:${group.tone}`} name={tool.icon} aria-hidden="true" />
                      <span>{tool.name}</span>
                    </span>
                    <span class="font-mono text-[11px] uppercase text-muted/70 group-hover:text-accent">
                      {tool.projects.length} {tool.projects.length === 1 ? "repo" : "repos"}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</tech-stack-inspector>

<script>
  class TechStackInspector extends HTMLElement {
    connectedCallback() {
      const nameEl = this.querySelector<HTMLElement>("[data-detail-name]");
      const groupEl = this.querySelector<HTMLElement>("[data-detail-group]");
      const summaryEl = this.querySelector<HTMLElement>("[data-detail-summary]");
      const projectsEl = this.querySelector<HTMLElement>("[data-detail-projects]");
      const items = this.querySelectorAll<HTMLButtonElement>("[data-stack-item]");
      if (!nameEl || !groupEl || !summaryEl || !projectsEl) return;

      const selectTool = (btn: HTMLButtonElement) => {
        items.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("border-border", active);
          b.classList.toggle("bg-surface/70", active);
          b.classList.toggle("text-foreground", active);
        });

        nameEl.textContent = btn.dataset.toolName ?? "";
        groupEl.textContent = btn.dataset.toolGroup ?? "";
        summaryEl.textContent = btn.dataset.toolSummary ?? "";

        try {
          const projects = JSON.parse(btn.dataset.toolProjects ?? "[]") as { label: string; href: string }[];
          projectsEl.replaceChildren(
            ...projects.map((p) => {
              const a = document.createElement("a");
              a.href = p.href;
              a.className =
                "border border-border bg-raised px-2.5 py-1 font-mono text-xs uppercase text-foreground no-underline transition-colors hover:border-accent hover:text-accent";
              a.textContent = `${p.label} →`;
              return a;
            }),
          );
        } catch {
          // ignore malformed JSON
        }
      };

      items.forEach((btn, idx) => {
        if (idx === 0) selectTool(btn);
        btn.addEventListener("pointerenter", () => selectTool(btn));
        btn.addEventListener("click", () => selectTool(btn));
      });
    }
  }

  if (!customElements.get("tech-stack-inspector")) {
    customElements.define("tech-stack-inspector", TechStackInspector);
  }
</script>

