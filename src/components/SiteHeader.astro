---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "Home", href: `${base}/` },
  { label: "About", href: `${base}/about/` },
  { label: "Work", href: `${base}/work/` },
  { label: "Contact", href: `${base}/contact/` },
];

const isActive = (href: string) => currentPath === href.replace(/\/$/, "");
---

<header class="sticky top-0 z-40 grid min-h-14 grid-cols-[auto_1fr_auto] items-center border-b border-border bg-surface/85 px-4 backdrop-blur-xl sm:px-6 lg:px-10">
  <a class="w-max font-mono text-sm font-medium no-underline" href={`${base}/`} aria-label="Karlo Jagar, home">KJ<span class="text-accent">/</span></a>
  <nav class="mx-auto flex self-stretch" aria-label="Main navigation">
    {links.map((link) => (
      <a
        class:list={[
          "relative grid min-h-14 place-items-center px-2 font-mono text-[9px] uppercase no-underline transition-colors sm:px-4",
          isActive(link.href) ? "text-foreground after:absolute after:inset-x-2 after:bottom-0 after:h-px after:bg-accent" : "text-muted hover:text-foreground",
        ]}
        href={link.href}
        aria-current={isActive(link.href) ? "page" : undefined}
      >{link.label}</a>
    ))}
  </nav>
  <div class="flex items-center justify-self-end gap-2">
    <a class="hidden font-mono text-[9px] uppercase text-muted no-underline transition-colors hover:text-accent lg:block" href="https://github.com/jagarkarlo" target="_blank" rel="noreferrer">
      GitHub <span aria-hidden="true">↗</span>
    </a>
    <button class="grid size-10 place-items-center border border-border bg-surface text-foreground transition-colors hover:border-accent hover:text-accent" type="button" data-terminal-open aria-label="Open operations console" title="Open operations console (Ctrl or Command + K)">
      <Icon class="size-4" name="kj-terminal" aria-hidden="true" />
    </button>
    <ThemeToggle />
  </div>
</header>