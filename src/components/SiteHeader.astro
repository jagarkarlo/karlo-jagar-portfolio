---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "Home", href: `${base}/` },
  { label: "About", href: `${base}/about/` },
  { label: "Work", href: `${base}/work/` },
  { label: "Contact", href: `${base}/contact/` },
];

const isActive = (href: string) => currentPath === href.replace(/\/$/, "");
---

<header class="site-header">
  <a class="wordmark" href={`${base}/`} aria-label="Karlo Jagar, home">KJ<span>.</span></a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
    ))}
  </nav>
  <a class="header-social" href="https://github.com/jagarkarlo" target="_blank" rel="noreferrer">
    GitHub <span aria-hidden="true">↗</span>
  </a>
</header>