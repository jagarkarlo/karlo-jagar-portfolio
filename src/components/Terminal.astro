---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<dialog class="m-auto w-[min(62rem,calc(100%-2rem))] border border-border bg-raised/95 p-0 text-foreground shadow-2xl backdrop:bg-canvas/85 backdrop:backdrop-blur-sm" data-terminal data-base={base} aria-labelledby="terminal-title">
  <div class="flex items-center justify-between border-b border-border px-4 py-3 sm:px-5">
    <div class="flex items-center gap-3">
      <span class="size-2 bg-accent"></span>
      <h2 class="font-mono text-[9px] font-normal uppercase text-foreground" id="terminal-title">Platform operations console</h2>
      <span class="hidden font-mono text-[8px] uppercase text-muted sm:inline">Session 01 / Zagreb</span>
    </div>
    <button class="grid size-8 place-items-center border border-transparent font-mono text-sm text-muted hover:border-border hover:text-foreground" type="button" data-terminal-close aria-label="Close terminal">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="grid min-h-[26rem] sm:grid-cols-[13rem_1fr]">
    <aside class="hidden border-r border-border bg-surface/50 p-5 font-mono text-[8px] uppercase sm:block" aria-label="Console status">
      <p class="text-muted">Runtime</p>
      <dl class="mt-5 space-y-4">
        <div><dt class="text-muted">Operator</dt><dd class="mt-1 text-foreground">Karlo Jagar</dd></div>
        <div><dt class="text-muted">Role</dt><dd class="mt-1 text-foreground">DevOps engineer</dd></div>
        <div><dt class="text-muted">Focus</dt><dd class="mt-1 text-foreground">Platforms / telemetry</dd></div>
        <div><dt class="text-muted">Status</dt><dd class="mt-1 flex items-center gap-2 text-accent"><span class="size-1.5 bg-accent"></span> Available</dd></div>
      </dl>
      <p class="mt-10 border-t border-border pt-4 leading-5 text-muted">Navigate with commands. Press Esc to close.</p>
    </aside>
    <div class="max-h-[64svh] min-h-[26rem] overflow-y-auto p-5 font-mono text-xs leading-6 sm:p-7" data-terminal-output aria-live="polite">
      <p class="text-accent">Connection established.</p>
      <p class="mt-2 text-muted">Portfolio context loaded. Type <span class="text-foreground">help</span> to list commands.</p>
      <p class="mt-6 text-muted">karlo@platform:~</p>
    </div>
  </div>
  <form class="flex items-center gap-3 border-t border-border px-5 py-4 font-mono text-xs sm:px-7" data-terminal-form>
    <label class="text-accent" for="terminal-input">karlo@platform:~$</label>
    <input class="min-w-0 flex-1 border-0 bg-transparent text-foreground caret-accent outline-none placeholder:text-muted" id="terminal-input" data-terminal-input autocomplete="off" spellcheck="false" placeholder="help" aria-label="Terminal command" />
  </form>
</dialog>

<script>
  const listenerOptions = {};

  const getRoutes = () => {
    const base = document.querySelector("[data-terminal]")?.getAttribute("data-base") ?? "";
    return {
      home: `${base}/`,
      about: `${base}/about/`,
      work: `${base}/work/`,
      contact: `${base}/contact/`,
    };
  };

  const lines: Record<string, string[]> = {
    help: ["PROFILE", "  about      Short profile", "  stack      Current toolset", "  contact    Public links", "NAVIGATION", "  home  work  github", "SYSTEM", "  status  clear  exit"],
    about: ["DevOps engineer in Zagreb working with cloud infrastructure, Kubernetes, observability, and developer tooling."],
    work: ["Reliability Replay", "GitLab Jira Context MCP", "Azure DevOps Challenge", "QuantumQuarry", "SDN Security Aspects", "PC Status Monitor"],
    stack: ["Kubernetes  Argo CD  Docker", "Azure  Terraform  Linux", "Prometheus  Grafana  Loki", "TypeScript  Python  GitLab"],
    contact: ["LinkedIn: linkedin.com/in/karlojagar", "GitHub: github.com/jagarkarlo"],
    status: ["platform    healthy", "projects    6 public repositories", "location    Zagreb, Croatia", "availability open to useful conversations"],
  };

  const appendLine = (text: string, className = "text-muted") => {
    const output = document.querySelector("[data-terminal-output]");
    const paragraph = document.createElement("p");
    paragraph.className = className;
    paragraph.textContent = text;
    output?.append(paragraph);
  };

  const openTerminal = () => {
    const terminal = document.querySelector("[data-terminal]");
    const input = document.querySelector("[data-terminal-input]");
    if (terminal instanceof HTMLDialogElement && !terminal.open) terminal.showModal();
    if (input instanceof HTMLInputElement) input.focus();
  };

  const closeTerminal = () => {
    const terminal = document.querySelector("[data-terminal]");
    if (terminal instanceof HTMLDialogElement) terminal.close();
  };

  window.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("[data-terminal-open]")) openTerminal();
    if (event.target.closest("[data-terminal-close]")) closeTerminal();
    if (event.target.matches("[data-terminal]")) closeTerminal();
  }, listenerOptions);
  window.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openTerminal();
    }
  }, listenerOptions);

  window.addEventListener("submit", (event) => {
    if (!(event.target instanceof HTMLFormElement) || !event.target.matches("[data-terminal-form]")) return;
    event.preventDefault();
    const input = document.querySelector("[data-terminal-input]");
    const output = document.querySelector("[data-terminal-output]");
    if (!(input instanceof HTMLInputElement)) return;
    const command = input.value.trim().toLowerCase();
    appendLine(`karlo@platform:~$ ${command}`, "mt-4 text-accent");
    input.value = "";

    if (!command) return;
    if (command === "clear") {
      if (output) output.innerHTML = "";
      return;
    }
    if (command === "exit") {
      closeTerminal();
      return;
    }
    if (command === "github") {
      window.open("https://github.com/jagarkarlo", "_blank", "noopener,noreferrer");
      appendLine("Opening GitHub...");
      return;
    }
    const routes = getRoutes();
    if (command in routes) {
      window.location.href = routes[command as keyof typeof routes];
      return;
    }
    const response = lines[command];
    if (response) response.forEach((line) => appendLine(line));
    else appendLine(`Command not found: ${command}. Type help.`, "text-[#e5a098]");
    output?.scrollTo({ top: output.scrollHeight, behavior: "smooth" });
  }, listenerOptions);
</script>
