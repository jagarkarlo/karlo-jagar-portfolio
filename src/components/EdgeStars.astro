---
// Deterministic positions keep the composition stable across builds and navigation.
const stars = Array.from({ length: 84 }, (_, i) => ({
  x: i < 12 ? ((i * 73 + 19) % 5) : 64 + ((i * 73 + 19) % 37),
  mobileX: i % 2 === 0 ? ((i * 17 + 3) % 5) : 96 + ((i * 17 + 3) % 5),
  y: ((i * 47 + 7) % 103),
  size: i % 13 === 0 ? 3 : i % 4 === 0 ? 2 : 1,
  tone: ["var(--theme-accent)", "var(--theme-cyan)", "var(--theme-violet)", "var(--theme-warm)"][i % 4],
  delay: -(i % 17),
}));
---

<edge-stars data-suspended>
  <div class="edge-stars__sky" aria-hidden="true">
    <div class="edge-stars__drift">
      {stars.map((star, i) => (
        <span
          class:list={["edge-stars__star", { "edge-stars__glint": i % 13 === 0 }]}
          style={`--x:${star.x}%;--mobile-x:${star.mobileX}%;--y:${star.y}%;--size:${star.size}px;--tone:${star.tone};--delay:${star.delay}s`}
        />
      ))}
    </div>
  </div>
  <button type="button" class="edge-stars__control" aria-label="Pause animation" title="Pause animation" hidden>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path data-pause-icon d="M4 3h3v10H4zm5 0h3v10H9z" />
      <path data-play-icon d="M4 2l9 6-9 6z" data-hidden />
    </svg>
  </button>
</edge-stars>

<script>
  class EdgeStarsElement extends HTMLElement {
    private controller?: AbortController;
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      const controller = new AbortController();
      this.controller = controller;
      const button = this.querySelector("button");
      const sky = this.querySelector<HTMLElement>(".edge-stars__sky");
      if (!button || !sky) {
        console.error("Home starfield is missing its sky or motion control.");
        return;
      }
      let paused = false;
      let inView = true;
      const update = () => {
        this.toggleAttribute("data-suspended", paused || !inView || document.hidden);
        const label = paused ? "Resume animation" : "Pause animation";
        button.setAttribute("aria-label", label);
        button.title = label;
        this.querySelector("[data-pause-icon]")?.toggleAttribute("data-hidden", paused);
        this.querySelector("[data-play-icon]")?.toggleAttribute("data-hidden", !paused);
      };
      button.hidden = false;
      button.addEventListener("click", () => {
        paused = !paused;
        update();
        this.dispatchEvent(new CustomEvent("home:motion", { bubbles: true, detail: { paused } }));
      }, { signal: controller.signal });
      document.addEventListener("visibilitychange", update, { signal: controller.signal });
      this.observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        update();
      });
      this.observer.observe(sky);
      update();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
    }
  }

  if (!customElements.get("edge-stars")) customElements.define("edge-stars", EdgeStarsElement);
</script>

<style>
  edge-stars {
    display: block;
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .edge-stars__sky {
    height: calc(100svh - 7.5rem);
    inset: 0 0 auto;
    overflow: hidden;
    position: absolute;
  }

  .edge-stars__drift {
    animation: edge-drift 28s ease-in-out infinite alternate;
    inset: -16px 0;
    position: absolute;
  }

  .edge-stars__star {
    background: var(--tone);
    border-radius: 50%;
    height: var(--size);
    left: var(--x);
    opacity: 0.7;
    position: absolute;
    top: var(--y);
    width: var(--size);
  }

  .edge-stars__glint {
    animation: edge-shimmer 9s ease-in-out var(--delay) infinite alternate;
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--tone) 30%, transparent);
  }

  .edge-stars__glint::before,
  .edge-stars__glint::after {
    background: linear-gradient(transparent, var(--tone), transparent);
    content: "";
    height: 15px;
    left: 1px;
    opacity: 0.55;
    position: absolute;
    top: -6px;
    width: 1px;
  }

  .edge-stars__glint::after { transform: rotate(90deg); }

  .edge-stars__control {
    align-items: center;
    background: var(--theme-surface);
    border: 1px solid var(--theme-border);
    color: var(--theme-muted);
    cursor: pointer;
    display: flex;
    height: 44px;
    justify-content: center;
    margin-left: auto;
    pointer-events: auto;
    position: sticky;
    top: calc(3.5rem + 2rem);
    width: 44px;
    z-index: 2;
  }

  .edge-stars__control:hover { color: var(--theme-accent); border-color: var(--theme-accent); }
  [hidden], [data-hidden] { display: none; }
  edge-stars[data-suspended] .edge-stars__drift,
  edge-stars[data-suspended] .edge-stars__glint { animation-play-state: paused; }

  @keyframes edge-drift { to { transform: translateY(14px); } }
  @keyframes edge-shimmer { from { opacity: 0.3; } to { opacity: 0.85; } }

  @media (max-width: 63.99rem) {
    .edge-stars__star { left: var(--mobile-x); }
    .edge-stars__star:not(:nth-child(3n)) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge-stars__drift, .edge-stars__glint { animation: none; }
    .edge-stars__control { display: none; }
  }
</style>
