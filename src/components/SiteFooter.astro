---
import { Icon } from "astro-icon/components";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="relative overflow-hidden border-t border-border bg-surface">
  <div class="pointer-events-none absolute inset-0 opacity-50" aria-hidden="true">
    <div class="absolute -top-24 left-[12%] size-52 rounded-full border border-border"></div>
    <div class="absolute top-12 right-[10%] h-px w-72 rotate-[-18deg] bg-border"></div>
    <div class="absolute top-16 right-[21%] size-1 bg-accent"></div>
  </div>
  <div class="relative border-b border-border px-6 py-4 sm:px-10 lg:px-[6vw]">
    <div class="mx-auto flex max-w-[94rem] flex-wrap items-center justify-between gap-4 font-mono text-xs uppercase text-muted">
      <span class="flex items-center gap-2"><i class="size-1.5 bg-accent not-italic"></i> All portfolio systems nominal</span>
      <span>Last build / GitHub Pages</span>
    </div>
  </div>
  <div class="relative px-6 py-12 sm:px-10 lg:px-[6vw] lg:py-16">
    <div class="mx-auto grid max-w-[94rem] gap-12 lg:grid-cols-[1.2fr_.8fr_auto] lg:items-end lg:gap-20">
      <div>
        <a class="inline-flex items-center gap-3 text-xl font-semibold no-underline" href={`${base}/`}><span class="grid size-8 place-items-center bg-foreground font-mono text-xs text-canvas">&gt;_</span>Karlo Jagar</a>
        <p class="mt-4 max-w-sm text-sm leading-6 text-muted">DevOps engineer building observable platforms and practical developer tools.</p>
      </div>
      <nav class="grid grid-cols-2 gap-x-10 gap-y-3 font-mono text-xs uppercase text-muted" aria-label="Footer navigation">
        <a class="w-max no-underline transition-colors hover:text-accent" href={`${base}/`}>Home</a>
        <a class="w-max no-underline transition-colors hover:text-accent" href={`${base}/about/`}>About</a>
        <a class="w-max no-underline transition-colors hover:text-accent" href={`${base}/work/`}>Work</a>
        <a class="w-max no-underline transition-colors hover:text-accent" href={`${base}/contact/`}>Contact</a>
      </nav>
      <div class="flex items-center gap-2">
        <a class="grid size-10 place-items-center border border-border text-muted no-underline transition-colors hover:border-accent hover:text-accent" href="https://github.com/jagarkarlo" target="_blank" rel="noreferrer" aria-label="GitHub"><Icon class="size-4" name="simple-icons:github" aria-hidden="true" /></a>
        <a class="grid size-10 place-items-center border border-border text-muted no-underline transition-colors hover:border-accent hover:text-accent" href="https://www.linkedin.com/in/karlojagar/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><Icon class="size-4" name="simple-icons:linkedin" aria-hidden="true" /></a>
        <a class="grid size-10 place-items-center rounded-full border border-border text-muted no-underline transition-colors hover:border-accent hover:text-accent" href="#main-content" aria-label="Back to top"><Icon class="size-4" name="lucide:arrow-up" aria-hidden="true" /></a>
      </div>
      <div class="flex flex-wrap justify-between gap-4 border-t border-border pt-6 font-mono text-xs uppercase text-muted lg:col-span-3">
        <p>© {new Date().getFullYear()} Karlo Jagar</p>
        <p>Astro / Tailwind CSS / Canvas</p>
      </div>
    </div>
  </div>
</footer>