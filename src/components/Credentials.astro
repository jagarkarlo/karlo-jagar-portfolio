---
type Credential = {
  title: string;
  issuer: string;
  date: string;
};

type Language = {
  language: string;
  level: string;
};

type Props = {
  certifications: Credential[];
  languages: Language[];
};

const { certifications, languages } = Astro.props;
---

<section class="grid gap-12 bg-mist px-6 py-20 sm:px-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-24 lg:px-[8vw] lg:py-28" id="credentials" aria-labelledby="credentials-title">
  <div>
    <p class="font-mono text-[10px] uppercase text-ink/50">08 / Credentials</p>
    <h2 class="mt-4 max-w-xl text-4xl leading-tight font-semibold tracking-[-0.035em] sm:text-5xl" id="credentials-title">Certifications and languages</h2>
  </div>
  <div class="grid gap-12 sm:grid-cols-[1.4fr_.6fr]">
    <section aria-labelledby="certifications-title">
      <h3 class="font-mono text-[10px] font-medium uppercase" id="certifications-title">Certifications</h3>
      <ul class="mt-4 list-none p-0">
        {certifications.map((item) => (
          <li class="grid grid-cols-[1fr_auto] gap-2 border-t border-line py-5"><strong class="col-span-2 text-[15px] font-medium">{item.title}</strong><span class="font-mono text-[9px] uppercase text-ink/50">{item.issuer}</span><time class="font-mono text-[9px] uppercase text-ink/50">{item.date}</time></li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="languages-title">
      <h3 class="font-mono text-[10px] font-medium uppercase" id="languages-title">Languages</h3>
      <ul class="mt-4 list-none p-0">
        {languages.map((item) => (
          <li class="grid gap-2 border-t border-line py-5"><strong class="text-[15px] font-medium">{item.language}</strong><span class="font-mono text-[9px] uppercase text-ink/50">{item.level}</span></li>
        ))}
      </ul>
    </section>
  </div>
</section>