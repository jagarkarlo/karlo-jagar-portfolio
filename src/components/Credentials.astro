---
type Credential = {
  title: string;
  issuer: string;
  date: string;
};

type Language = {
  language: string;
  level: string;
};

type Props = {
  certifications: Credential[];
  languages: Language[];
};

const { certifications, languages } = Astro.props;
---

<section class="credentials" id="credentials" aria-labelledby="credentials-title">
  <div>
    <p class="section-label">08 / Credentials</p>
    <h2 id="credentials-title">Certifications and languages</h2>
  </div>
  <div class="credential-groups">
    <section aria-labelledby="certifications-title">
      <h3 id="certifications-title">Certifications</h3>
      <ul>
        {certifications.map((item) => (
          <li><strong>{item.title}</strong><span>{item.issuer}</span><time>{item.date}</time></li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="languages-title">
      <h3 id="languages-title">Languages</h3>
      <ul>
        {languages.map((item) => (
          <li><strong>{item.language}</strong><span>{item.level}</span></li>
        ))}
      </ul>
    </section>
  </div>
</section>