<hero-scene class="hero-scene" aria-hidden="true">
  <canvas data-depth-field aria-hidden="true"></canvas>
</hero-scene>

<script>
  class HeroSceneElement extends HTMLElement {
    controller?: AbortController;
    resizeObserver?: ResizeObserver;
    visibilityObserver?: IntersectionObserver;
    frame = 0;
    visible = true;

    connectedCallback() {
      const canvas = this.querySelector("[data-depth-field]");
      const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
      if (!(canvas instanceof HTMLCanvasElement) || !context) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
      const nodes = Array.from({ length: 42 }, (_, index) => ({
        x: ((index * 47) % 101) / 100,
        y: ((index * 67 + 13) % 97) / 96,
        depth: 0.35 + ((index * 29) % 61) / 100,
        phase: ((index * 31) % 100) / 100 * Math.PI * 2,
      }));
      let width = 0;
      let height = 0;

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        width = bounds.width;
        height = bounds.height;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const draw = (time = 0) => {
        context.clearRect(0, 0, width, height);
        const styles = getComputedStyle(document.documentElement);
        const foreground = styles.getPropertyValue("--theme-foreground").trim();
        const accent = styles.getPropertyValue("--theme-accent").trim();
        const columns = width < 640 ? 9 : 16;
        const rows = width < 640 ? 12 : 15;
        const horizon = height * 0.52;
        const phase = reducedMotion.matches ? 0 : time * 0.00012;

        pointer.x += (pointer.targetX - pointer.x) * 0.06;
        pointer.y += (pointer.targetY - pointer.y) * 0.06;
        const shiftX = pointer.x * 18;
        const shiftY = pointer.y * 12;

        context.strokeStyle = foreground;
        context.lineWidth = 0.7;
        for (let column = -columns; column <= columns; column += 1) {
          const originX = width / 2 + column * width * 0.055 + shiftX;
          context.beginPath();
          context.moveTo(width / 2 + shiftX * 0.2, horizon + shiftY * 0.2);
          context.lineTo(originX * 2 - width / 2, height + 20);
          context.globalAlpha = column % 4 === 0 ? 0.16 : 0.07;
          context.stroke();
        }

        for (let row = 0; row < rows; row += 1) {
          const progress = row / rows;
          const perspective = progress * progress;
          const y = horizon + perspective * (height - horizon) + Math.sin(row * 0.8 + phase * 4) * 2 + shiftY * perspective;
          context.beginPath();
          context.moveTo(-20, y);
          context.lineTo(width + 20, y);
          context.globalAlpha = row % 4 === 0 ? 0.15 : 0.065;
          context.stroke();
        }

        const fieldNodes = nodes.map((node) => ({
          x: node.x * width + pointer.x * node.depth * 32,
          y: node.y * height + pointer.y * node.depth * 22 + Math.sin(node.phase + phase * 3) * 2,
          depth: node.depth,
        }));

        fieldNodes.forEach((node, index) => {
          fieldNodes.slice(index + 1).forEach((candidate) => {
            const distance = Math.hypot(node.x - candidate.x, node.y - candidate.y);
            if (distance > Math.min(width, height) * 0.18) return;
            context.beginPath();
            context.moveTo(node.x, node.y);
            context.lineTo(candidate.x, candidate.y);
            context.strokeStyle = index % 5 === 0 ? accent : foreground;
            context.globalAlpha = (1 - distance / (Math.min(width, height) * 0.18)) * 0.16;
            context.lineWidth = 0.7;
            context.stroke();
          });

          context.beginPath();
          context.arc(node.x, node.y, index % 9 === 0 ? 2.1 : 1.1, 0, Math.PI * 2);
          context.fillStyle = index % 9 === 0 ? accent : foreground;
          context.globalAlpha = index % 9 === 0 ? 0.72 : 0.28;
          context.fill();
        });

        const core = { x: width / 2 + shiftX * 0.12, y: height * 0.34 + shiftY * 0.12 };
        for (let ring = 0; ring < 4; ring += 1) {
          const pulse = reducedMotion.matches ? ring / 4 : (phase * 0.45 + ring / 4) % 1;
          context.beginPath();
          context.ellipse(core.x, core.y, 28 + pulse * Math.min(width, height) * 0.31, 18 + pulse * Math.min(width, height) * 0.17, pointer.x * 0.35, 0, Math.PI * 2);
          context.strokeStyle = ring === 1 ? accent : foreground;
          context.globalAlpha = (1 - pulse) * 0.11;
          context.lineWidth = 0.8;
          context.stroke();
        }

        context.globalAlpha = 1;

        if (!reducedMotion.matches && this.visible) this.frame = requestAnimationFrame(draw);
      };

      const restart = () => {
        cancelAnimationFrame(this.frame);
        draw(performance.now());
      };

      this.addEventListener("pointermove", (event) => {
        const bounds = this.getBoundingClientRect();
        pointer.targetX = (event.clientX - bounds.left) / bounds.width - 0.5;
        pointer.targetY = (event.clientY - bounds.top) / bounds.height - 0.5;
      }, { signal: this.controller.signal });
      this.addEventListener("pointerleave", () => {
        pointer.targetX = 0;
        pointer.targetY = 0;
      }, { signal: this.controller.signal });

      this.resizeObserver = new ResizeObserver(() => {
        resize();
        restart();
      });
      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible) restart();
        else cancelAnimationFrame(this.frame);
      });
      this.resizeObserver.observe(this);
      this.visibilityObserver.observe(this);
      reducedMotion.addEventListener("change", restart, { signal: this.controller.signal });
      resize();
      restart();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.controller?.abort();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
    }
  }

  if (!customElements.get("hero-scene")) customElements.define("hero-scene", HeroSceneElement);
</script>

<style>
  .hero-scene {
    inset: 0;
    overflow: hidden;
    position: absolute;
  }

  .hero-scene::after {
    background: radial-gradient(circle at 50% 38%, transparent 0 17%, color-mix(in srgb, var(--theme-canvas) 16%, transparent) 48%, var(--theme-canvas) 100%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero-scene canvas {
    height: 100%;
    width: 100%;
  }

</style>