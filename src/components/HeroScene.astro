<hero-scene class="hero-scene" aria-hidden="true">
  <canvas data-depth-field></canvas>
  <div class="scene-window scene-window--deploy" data-depth="0.85">
    <header><span></span><span>deploy / main</span><b>healthy</b></header>
    <div class="deploy-flow"><i>git</i><em></em><i>build</i><em></em><i>aks</i></div>
    <footer>release 01 / reconciled</footer>
  </div>
  <div class="scene-window scene-window--observe" data-depth="0.55">
    <header><span></span><span>signals / 15m</span><b>live</b></header>
    <div class="metric"><strong>99.98%</strong><small>availability</small></div>
    <div class="sparkline"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
  </div>
  <div class="scene-window scene-window--context" data-depth="1.05">
    <header><span></span><span>context / tools</span><b>ready</b></header>
    <ul><li>GitLab <b>read</b></li><li>Jira <b>read</b></li><li>Docs <b>read</b></li></ul>
  </div>
  <div class="scene-orbit scene-orbit--one"></div>
  <div class="scene-orbit scene-orbit--two"></div>
</hero-scene>

<script>
  class HeroSceneElement extends HTMLElement {
    controller?: AbortController;
    resizeObserver?: ResizeObserver;
    visibilityObserver?: IntersectionObserver;
    frame = 0;
    visible = true;

    connectedCallback() {
      const canvas = this.querySelector("[data-depth-field]");
      const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
      if (!(canvas instanceof HTMLCanvasElement) || !context) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
      let width = 0;
      let height = 0;

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        width = bounds.width;
        height = bounds.height;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const draw = (time = 0) => {
        context.clearRect(0, 0, width, height);
        const styles = getComputedStyle(document.documentElement);
        const foreground = styles.getPropertyValue("--theme-foreground").trim();
        const accent = styles.getPropertyValue("--theme-accent").trim();
        const columns = width < 640 ? 9 : 16;
        const rows = width < 640 ? 12 : 15;
        const horizon = height * 0.46;
        const phase = reducedMotion.matches ? 0 : time * 0.00012;

        pointer.x += (pointer.targetX - pointer.x) * 0.06;
        pointer.y += (pointer.targetY - pointer.y) * 0.06;
        const shiftX = pointer.x * 18;
        const shiftY = pointer.y * 12;

        context.strokeStyle = foreground;
        context.lineWidth = 0.7;
        for (let column = -columns; column <= columns; column += 1) {
          const originX = width / 2 + column * width * 0.055 + shiftX;
          context.beginPath();
          context.moveTo(width / 2 + shiftX * 0.2, horizon + shiftY * 0.2);
          context.lineTo(originX * 2 - width / 2, height + 20);
          context.globalAlpha = column % 4 === 0 ? 0.16 : 0.07;
          context.stroke();
        }

        for (let row = 0; row < rows; row += 1) {
          const progress = row / rows;
          const perspective = progress * progress;
          const y = horizon + perspective * (height - horizon) + Math.sin(row * 0.8 + phase * 4) * 2 + shiftY * perspective;
          context.beginPath();
          context.moveTo(-20, y);
          context.lineTo(width + 20, y);
          context.globalAlpha = row % 4 === 0 ? 0.15 : 0.065;
          context.stroke();
        }

        const points = width < 640 ? 18 : 34;
        for (let point = 0; point < points; point += 1) {
          const depth = ((point * 0.618 + phase * (0.25 + point % 4 * 0.08)) % 1 + 1) % 1;
          const spread = depth * depth;
          const angle = point * 2.399;
          const x = width / 2 + Math.cos(angle) * width * spread * 0.7 + shiftX * spread;
          const y = horizon + Math.sin(angle) * height * spread * 0.34 + depth * height * 0.24 + shiftY * spread;
          const size = 1 + depth * 2;
          context.fillStyle = point % 6 === 0 ? accent : foreground;
          context.globalAlpha = point % 6 === 0 ? 0.8 : 0.3;
          context.fillRect(x - size / 2, y - size / 2, size, size);
        }

        context.globalAlpha = 1;
        this.querySelectorAll<HTMLElement>("[data-depth]").forEach((panel) => {
          const depth = Number(panel.dataset.depth ?? 1);
          panel.style.setProperty("--scene-x", `${pointer.x * depth * 16}px`);
          panel.style.setProperty("--scene-y", `${pointer.y * depth * 10}px`);
          panel.style.setProperty("--scene-rx", `${pointer.y * depth * -3}deg`);
          panel.style.setProperty("--scene-ry", `${pointer.x * depth * 4}deg`);
        });

        if (!reducedMotion.matches && this.visible) this.frame = requestAnimationFrame(draw);
      };

      const restart = () => {
        cancelAnimationFrame(this.frame);
        draw(performance.now());
      };

      this.addEventListener("pointermove", (event) => {
        const bounds = this.getBoundingClientRect();
        pointer.targetX = (event.clientX - bounds.left) / bounds.width - 0.5;
        pointer.targetY = (event.clientY - bounds.top) / bounds.height - 0.5;
      }, { signal: this.controller.signal });
      this.addEventListener("pointerleave", () => {
        pointer.targetX = 0;
        pointer.targetY = 0;
      }, { signal: this.controller.signal });

      this.resizeObserver = new ResizeObserver(() => {
        resize();
        restart();
      });
      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible) restart();
        else cancelAnimationFrame(this.frame);
      });
      this.resizeObserver.observe(this);
      this.visibilityObserver.observe(this);
      reducedMotion.addEventListener("change", restart, { signal: this.controller.signal });
      resize();
      restart();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.controller?.abort();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
    }
  }

  if (!customElements.get("hero-scene")) customElements.define("hero-scene", HeroSceneElement);
</script>

<style>
  .hero-scene {
    inset: 0;
    overflow: hidden;
    perspective: 900px;
    pointer-events: auto;
    position: absolute;
  }

  .hero-scene::after {
    background: radial-gradient(circle at center, transparent 0 26%, color-mix(in srgb, var(--theme-canvas) 22%, transparent) 64%, var(--theme-canvas) 100%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero-scene canvas {
    height: 100%;
    width: 100%;
  }

  .scene-window {
    --scene-rx: 0deg;
    --scene-ry: 0deg;
    --scene-x: 0px;
    --scene-y: 0px;
    background: color-mix(in srgb, var(--theme-raised) 82%, transparent);
    border: 1px solid color-mix(in srgb, var(--theme-border) 88%, transparent);
    box-shadow: 0 24px 70px rgb(0 0 0 / 24%);
    color: var(--theme-muted);
    font-family: var(--font-mono);
    font-size: 0.48rem;
    padding: 0.75rem;
    position: absolute;
    transform: translate3d(var(--scene-x), var(--scene-y), 0) rotateX(var(--scene-rx)) rotateY(var(--scene-ry));
    transform-style: preserve-3d;
    transition: border-color 180ms ease;
    width: clamp(10rem, 17vw, 15rem);
    z-index: 1;
  }

  .scene-window:hover { border-color: var(--theme-accent); }
  .scene-window header { align-items: center; display: grid; gap: 0.4rem; grid-template-columns: auto 1fr auto; text-transform: uppercase; }
  .scene-window header > span:first-child { background: var(--theme-accent); height: 0.35rem; width: 0.35rem; }
  .scene-window header b { color: var(--theme-accent); font-weight: 400; }
  .scene-window footer { border-top: 1px solid var(--theme-border); margin-top: 0.75rem; padding-top: 0.55rem; text-transform: uppercase; }
  .scene-window--deploy { left: 5%; top: 18%; transform-origin: right center; }
  .scene-window--observe { right: 5%; top: 15%; }
  .scene-window--context { bottom: 12%; right: 10%; width: clamp(9rem, 14vw, 12rem); }
  .deploy-flow { align-items: center; display: grid; gap: 0.3rem; grid-template-columns: auto 1fr auto 1fr auto; margin-top: 1rem; }
  .deploy-flow i { border: 1px solid var(--theme-border); color: var(--theme-foreground); font-style: normal; padding: 0.35rem; text-align: center; text-transform: uppercase; }
  .deploy-flow em { background: var(--theme-accent); height: 1px; opacity: 0.7; }
  .metric { align-items: end; display: flex; justify-content: space-between; margin-top: 0.8rem; }
  .metric strong { color: var(--theme-foreground); font-size: 1rem; font-weight: 500; }
  .metric small { text-transform: uppercase; }
  .sparkline { align-items: end; display: flex; gap: 0.25rem; height: 2.5rem; margin-top: 0.65rem; }
  .sparkline i { background: var(--theme-accent); flex: 1; height: 35%; opacity: 0.5; }
  .sparkline i:nth-child(2), .sparkline i:nth-child(6) { height: 72%; }
  .sparkline i:nth-child(3), .sparkline i:nth-child(7) { height: 52%; }
  .sparkline i:nth-child(4) { height: 88%; }
  .scene-window ul { list-style: none; margin: 0.8rem 0 0; padding: 0; }
  .scene-window li { border-top: 1px solid var(--theme-border); display: flex; justify-content: space-between; padding: 0.35rem 0; }
  .scene-window li b { color: var(--theme-accent); font-weight: 400; }
  .scene-orbit { border: 1px solid color-mix(in srgb, var(--theme-foreground) 10%, transparent); border-radius: 50%; position: absolute; }
  .scene-orbit--one { height: 26rem; left: calc(50% - 13rem); top: calc(48% - 13rem); transform: rotateX(62deg) rotateZ(24deg); width: 26rem; }
  .scene-orbit--two { height: 34rem; left: calc(50% - 17rem); top: calc(48% - 17rem); transform: rotateX(72deg) rotateZ(-18deg); width: 34rem; }

  @media (max-width: 47.99rem) {
    .scene-window--deploy { left: -2.5rem; top: 12%; }
    .scene-window--observe { right: -3.5rem; top: 18%; }
    .scene-window--context { bottom: 8%; right: -2rem; }
    .scene-window { opacity: 0.72; }
    .scene-orbit--two { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-window { transform: none; }
  }
</style>