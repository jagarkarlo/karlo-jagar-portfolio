<hero-scene class="hero-scene" aria-hidden="true">
  <canvas data-depth-field aria-hidden="true"></canvas>
</hero-scene>

<script>
  type Point = { x: number; y: number };

  class HeroSceneElement extends HTMLElement {
    controller?: AbortController;
    resizeObserver?: ResizeObserver;
    visibilityObserver?: IntersectionObserver;
    frame = 0;
    visible = true;

    connectedCallback() {
      const canvas = this.querySelector("[data-depth-field]");
      const context = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
      if (!(canvas instanceof HTMLCanvasElement) || !context) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
      const stars = Array.from({ length: 110 }, (_, index) => ({
        x: ((index * 73 + 11) % 997) / 997,
        y: ((index * 149 + 31) % 991) / 991,
        depth: 0.2 + ((index * 37) % 80) / 100,
        size: index % 17 === 0 ? 1.8 : index % 7 === 0 ? 1.1 : 0.55,
        phase: ((index * 43) % 100) / 100 * Math.PI * 2,
      }));
      const clusterSeeds = [
        { x: 0.12, y: 0.25, count: 12, radius: 0.11 },
        { x: 0.16, y: 0.59, count: 15, radius: 0.13 },
        { x: 0.5, y: 0.1, count: 10, radius: 0.1 },
        { x: 0.85, y: 0.26, count: 13, radius: 0.12 },
        { x: 0.84, y: 0.59, count: 16, radius: 0.14 },
      ];
      const meshNodes = clusterSeeds.flatMap((cluster, clusterIndex) => (
        Array.from({ length: cluster.count }, (_, nodeIndex) => {
          const angle = nodeIndex * 2.399 + clusterIndex * 0.73;
          const radius = cluster.radius * Math.sqrt((nodeIndex + 1) / cluster.count);
          return {
            x: cluster.x + Math.cos(angle) * radius,
            y: cluster.y + Math.sin(angle) * radius * 0.72,
            cluster: clusterIndex,
            depth: 0.42 + ((nodeIndex * 19 + clusterIndex * 7) % 48) / 100,
            phase: angle,
          };
        })
      ));
      let width = 0;
      let height = 0;

      const line = (from: Point, to: Point) => {
        context.beginPath();
        context.moveTo(from.x, from.y);
        context.lineTo(to.x, to.y);
        context.stroke();
      };

      const focusOpacity = (x: number, y: number) => {
        const horizontal = Math.abs(x / width - 0.5) / 0.27;
        const vertical = Math.abs(y / height - 0.43) / 0.32;
        return Math.min(1, 0.08 + Math.max(horizontal, vertical) ** 2);
      };

      const resize = () => {
        const bounds = this.getBoundingClientRect();
        const ratio = Math.min(window.devicePixelRatio || 1, 2);
        width = bounds.width;
        height = bounds.height;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        context.setTransform(ratio, 0, 0, ratio, 0, 0);
      };

      const draw = (time = 0) => {
        context.clearRect(0, 0, width, height);
        const styles = getComputedStyle(document.documentElement);
        const foreground = styles.getPropertyValue("--theme-foreground").trim();
        const accent = styles.getPropertyValue("--theme-accent").trim();
        const surface = styles.getPropertyValue("--theme-surface").trim();
        const mobile = width < 640;
        const phase = reducedMotion.matches ? 0 : time * 0.0001;

        pointer.x += (pointer.targetX - pointer.x) * 0.045;
        pointer.y += (pointer.targetY - pointer.y) * 0.045;

        stars.forEach((star, index) => {
          const x = star.x * width + pointer.x * star.depth * -38;
          const y = star.y * height + pointer.y * star.depth * -24;
          const twinkle = reducedMotion.matches ? 0.5 : 0.42 + Math.sin(phase * 8 + star.phase) * 0.25;
          context.beginPath();
          context.arc(x, y, star.size, 0, Math.PI * 2);
          context.fillStyle = index % 23 === 0 ? accent : foreground;
          context.globalAlpha = twinkle * focusOpacity(x, y);
          context.fill();
          if (index % 29 === 0) {
            context.strokeStyle = accent;
            context.globalAlpha = 0.18;
            line({ x: x - 5, y }, { x: x + 5, y });
            line({ x, y: y - 5 }, { x, y: y + 5 });
          }
        });

        const globe = {
          x: width * 0.5 + pointer.x * 12,
          y: height * (mobile ? 1.3 : 1.37) + pointer.y * 7,
          radius: Math.max(width * (mobile ? 1.02 : 0.67), height * 0.78),
        };
        const horizonY = globe.y - globe.radius;
        const atmosphere = context.createRadialGradient(globe.x, globe.y, globe.radius * 0.68, globe.x, globe.y, globe.radius);
        atmosphere.addColorStop(0, "transparent");
        atmosphere.addColorStop(0.9, surface);
        atmosphere.addColorStop(1, accent);
        context.beginPath();
        context.arc(globe.x, globe.y, globe.radius, Math.PI, Math.PI * 2);
        context.fillStyle = atmosphere;
        context.globalAlpha = 0.12;
        context.fill();
        context.strokeStyle = foreground;
        context.lineWidth = 0.9;
        context.globalAlpha = 0.36;
        context.stroke();

        context.save();
        context.beginPath();
        context.arc(globe.x, globe.y, globe.radius - 1, Math.PI, Math.PI * 2);
        context.lineTo(globe.x + globe.radius, height + 1);
        context.lineTo(globe.x - globe.radius, height + 1);
        context.closePath();
        context.clip();

        for (let latitude = 1; latitude <= 13; latitude += 1) {
          const progress = latitude / 14;
          const y = horizonY + progress * (height - horizonY + 90);
          const halfWidth = Math.sqrt(Math.max(0, globe.radius ** 2 - (y - globe.y) ** 2));
          context.beginPath();
          context.ellipse(globe.x, y, halfWidth, 7 + progress * 18, 0, Math.PI, Math.PI * 2);
          context.strokeStyle = latitude % 4 === 0 ? accent : foreground;
          context.globalAlpha = latitude % 4 === 0 ? 0.13 : 0.055;
          context.lineWidth = 0.65;
          context.stroke();
        }

        for (let longitude = -13; longitude <= 13; longitude += 1) {
          const angle = longitude / 13 * Math.PI * 0.52 + pointer.x * 0.05;
          context.beginPath();
          context.ellipse(globe.x, globe.y, Math.abs(Math.sin(angle)) * globe.radius, globe.radius, 0, Math.PI, Math.PI * 2);
          context.strokeStyle = longitude % 5 === 0 ? accent : foreground;
          context.globalAlpha = longitude % 5 === 0 ? 0.12 : 0.05;
          context.lineWidth = 0.65;
          context.stroke();
        }
        context.restore();

        const fieldNodes = meshNodes.map((node) => ({
          x: node.x * width + pointer.x * node.depth * 42,
          y: node.y * height + pointer.y * node.depth * 28 + Math.sin(node.phase + phase * 3) * 1.5,
          depth: node.depth,
          cluster: node.cluster,
        }));

        fieldNodes.forEach((node, index) => {
          fieldNodes.slice(index + 1).forEach((candidate) => {
            if (candidate.cluster !== node.cluster) return;
            const distance = Math.hypot(node.x - candidate.x, node.y - candidate.y);
            if (distance > Math.min(width, height) * 0.135) return;
            context.strokeStyle = index % 5 === 0 ? accent : foreground;
            context.globalAlpha = (1 - distance / (Math.min(width, height) * 0.135)) * 0.34 * focusOpacity(node.x, node.y);
            context.lineWidth = index % 11 === 0 ? 1 : 0.65;
            line(node, candidate);
          });

          context.beginPath();
          context.arc(node.x, node.y, index % 11 === 0 ? 2.6 : 1.25, 0, Math.PI * 2);
          context.fillStyle = index % 11 === 0 ? accent : foreground;
          context.globalAlpha = (index % 11 === 0 ? 0.9 : 0.5) * focusOpacity(node.x, node.y);
          context.fill();
        });

        const clusterCores = clusterSeeds.map((cluster, index) => ({
          x: cluster.x * width + pointer.x * (18 + index * 2),
          y: cluster.y * height + pointer.y * (12 + index * 2),
        }));
        const controlCore = { x: width * 0.5 + pointer.x * 9, y: height * 0.34 + pointer.y * 7 };
        clusterCores.forEach((core, index) => {
          const from = index === 2 ? { x: controlCore.x, y: horizonY + 6 } : core;
          const to = index === 2 ? core : controlCore;
          const bendY = Math.min(from.y, to.y) - height * (0.05 + index * 0.008);
          context.beginPath();
          context.moveTo(from.x, from.y);
          context.bezierCurveTo(from.x, bendY, to.x, bendY, to.x, to.y);
          context.strokeStyle = index % 2 === 0 ? accent : foreground;
          context.globalAlpha = mobile ? 0.11 : 0.2;
          context.setLineDash([2, 7]);
          context.stroke();
          context.setLineDash([]);

          const packet = reducedMotion.matches ? 0.55 : (phase * 0.55 + index * 0.19) % 1;
          const inverse = 1 - packet;
          const packetX = inverse ** 3 * from.x + 3 * inverse ** 2 * packet * from.x + 3 * inverse * packet ** 2 * to.x + packet ** 3 * to.x;
          const packetY = inverse ** 3 * from.y + 3 * inverse ** 2 * packet * bendY + 3 * inverse * packet ** 2 * bendY + packet ** 3 * to.y;
          context.fillStyle = accent;
          context.globalAlpha = 0.9 * focusOpacity(packetX, packetY);
          context.fillRect(packetX - 1.5, packetY - 1.5, 3, 3);
        });

        for (let ring = 0; ring < 5; ring += 1) {
          const radius = (mobile ? 82 : 120) + ring * (mobile ? 22 : 34);
          context.beginPath();
          context.ellipse(controlCore.x, controlCore.y, radius, radius * 0.42, pointer.x * 0.22 + ring * 0.08, 0, Math.PI * 2);
          context.strokeStyle = ring === 2 ? accent : foreground;
          context.globalAlpha = ring === 2 ? 0.15 : 0.07;
          context.lineWidth = 0.75;
          context.stroke();
        }

        for (let index = 0; index < 6; index += 1) {
          const progress = reducedMotion.matches ? index / 6 : (phase * 0.42 + index / 6) % 1;
          const angle = progress * Math.PI * 2 + index * 0.4;
          const radius = (mobile ? 95 : 142) + (index % 3) * 31;
          const x = controlCore.x + Math.cos(angle) * radius;
          const y = controlCore.y + Math.sin(angle) * radius * 0.42;
          context.beginPath();
          context.arc(x, y, index % 2 === 0 ? 2.2 : 1.4, 0, Math.PI * 2);
          context.fillStyle = accent;
          context.globalAlpha = 0.72 * focusOpacity(x, y);
          context.fill();
        }

        context.globalAlpha = 1;

        if (!reducedMotion.matches && this.visible) this.frame = requestAnimationFrame(draw);
      };

      const restart = () => {
        cancelAnimationFrame(this.frame);
        draw(performance.now());
      };

      this.addEventListener("pointermove", (event) => {
        const bounds = this.getBoundingClientRect();
        pointer.targetX = (event.clientX - bounds.left) / bounds.width - 0.5;
        pointer.targetY = (event.clientY - bounds.top) / bounds.height - 0.5;
      }, { signal: this.controller.signal });
      this.addEventListener("pointerleave", () => {
        pointer.targetX = 0;
        pointer.targetY = 0;
      }, { signal: this.controller.signal });

      this.resizeObserver = new ResizeObserver(() => {
        resize();
        restart();
      });
      this.visibilityObserver = new IntersectionObserver(([entry]) => {
        this.visible = entry.isIntersecting;
        if (this.visible) restart();
        else cancelAnimationFrame(this.frame);
      });
      this.resizeObserver.observe(this);
      this.visibilityObserver.observe(this);
      reducedMotion.addEventListener("change", restart, { signal: this.controller.signal });
      resize();
      restart();
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.frame);
      this.controller?.abort();
      this.resizeObserver?.disconnect();
      this.visibilityObserver?.disconnect();
    }
  }

  if (!customElements.get("hero-scene")) customElements.define("hero-scene", HeroSceneElement);
</script>

<style>
  .hero-scene {
    inset: 0;
    overflow: hidden;
    position: absolute;
  }

  .hero-scene::after {
    background:
      radial-gradient(ellipse at 50% 42%, color-mix(in srgb, var(--theme-canvas) 78%, transparent) 0 15%, transparent 38%),
      linear-gradient(90deg, color-mix(in srgb, var(--theme-canvas) 18%, transparent), transparent 22% 78%, color-mix(in srgb, var(--theme-canvas) 18%, transparent)),
      linear-gradient(0deg, color-mix(in srgb, var(--theme-canvas) 72%, transparent), transparent 32%);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .hero-scene canvas {
    height: 100%;
    width: 100%;
  }
</style>