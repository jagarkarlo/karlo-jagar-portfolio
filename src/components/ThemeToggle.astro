---
import { Icon } from "astro-icon/components";
---

<button
  class="theme-toggle grid size-10 place-items-center border border-border bg-surface text-foreground transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  type="button"
  data-theme-toggle
  aria-label="Switch color mode"
  title="Switch color mode"
>
  <Icon class="theme-icon-light size-4" name="lucide:sun" aria-hidden="true" />
  <Icon class="theme-icon-dark size-4" name="lucide:moon" aria-hidden="true" />
</button>

<script>
  const updateThemeControl = () => {
    const theme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.setAttribute("aria-label", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
      button.setAttribute("title", `Switch to ${theme === "dark" ? "light" : "dark"} mode`);
    });
  };

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-theme-toggle]")) return;
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    document.documentElement.style.colorScheme = nextTheme;
    document.querySelector("[data-theme-color]")?.setAttribute("content", nextTheme === "dark" ? "#090d10" : "#edf0ec");
    localStorage.setItem("portfolio-theme", nextTheme);
    updateThemeControl();
  });

  document.addEventListener("astro:page-load", updateThemeControl);
  updateThemeControl();
</script>