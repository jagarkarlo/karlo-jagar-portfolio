---
import type { TimelineItem } from "../data/profile";

type Props = {
  items: TimelineItem[];
};

const { items } = Astro.props;
---

<section class="recognition" id="recognition" aria-labelledby="recognition-title">
  <div class="recognition-heading">
    <p class="section-label">07 / Beyond the work</p>
    <h2 id="recognition-title">Contributing beyond<br /><em>the technical brief.</em></h2>
  </div>
  <div class="recognition-list">
    {items.map((item) => (
      <article>
        <div>
          <p>{item.organization}</p>
          <time>{item.period}</time>
        </div>
        <h3>{item.title}</h3>
        {item.description && <p>{item.description}</p>}
      </article>
    ))}
  </div>
</section>